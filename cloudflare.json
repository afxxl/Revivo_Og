{
  "zone_id": "YOUR_ZONE_ID",
  "purge_cache": true,
  "development_mode": false,
  "cache_level": "aggressive",
  "browser_cache_ttl": 14400,
  "always_online": true,
  "minify": {
    "js": true,
    "css": true,
    "html": true
  },
  "security_level": "medium",
  "ssl": "full",
  "rocket_loader": true,
  "email_obfuscation": "on",
  "server_side_exclude": "on",
  "hotlink_protection": "on",
  "polish": "lossless",
  "webp": "on",
  "brotli": "on"
}