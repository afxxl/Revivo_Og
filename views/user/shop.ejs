    <%- include('../partials/user/footer.ejs') %>

    <script>
      document.addEventListener('DOMContentLoaded', loadRandomShopImages);
      
      document.addEventListener('DOMContentLoaded', function() {
        const openFilterBtn = document.getElementById('open-filter');
        const closeFilterBtn = document.getElementById('close-filter');
        const filterSidebar = document.querySelector('.filter-sidebar');
        const filterOverlay = document.querySelector('.filter-overlay');
        
        openFilterBtn.addEventListener('click', function() {
          filterSidebar.classList.add('active');
          filterOverlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        });
        
        function closeFilterSidebar() {
          filterSidebar.classList.remove('active');
          filterOverlay.classList.remove('active');
          document.body.style.overflow = ''; 
        }
        
        closeFilterBtn.addEventListener('click', closeFilterSidebar);
        filterOverlay.addEventListener('click', closeFilterSidebar);
        
        // Reset filters button
        const resetFiltersBtn = document.getElementById('reset-filters');
        if (resetFiltersBtn) {
          resetFiltersBtn.addEventListener('click', function() {
            window.location.href = '/shop';
          });
        }
        
      document.getElementById('filterForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const formData = new FormData(this);
        const params = new URLSearchParams();
        for (const [key, value] of formData) {
          if (value && value !== '' && value !== 'undefined') {
            params.append(key, value);
          }
        }
        window.location.href = `/shop?${params.toString()}`;
        });
      });
      
      const toggleButton = document.getElementById('toggleFilters');
      const filterContainer = document.querySelector('.filter-container');

      if (toggleButton && filterContainer) {
        toggleButton.addEventListener('click', () => {
          filterContainer.classList.toggle('hidden');
        });
      }

      document.getElementById('mobile-category-filter')?.addEventListener('change', function() {
        const categoryId = this.value;
        const params = new URLSearchParams(window.location.search);
        if (categoryId === 'all') {
          params.delete('category');
        } else {
          params.set('category', categoryId);
        }
        params.delete('page'); 
        window.location.href = `/shop?${params.toString()}`;
      });

      document.addEventListener('DOMContentLoaded', function() {
        const slider = document.querySelector('.category-slider');
        const prevBtn = document.getElementById('prev-category');
        const nextBtn = document.getElementById('next-category');
        const sliderContainer = document.querySelector('.category-slider-container');
        
        if (!slider || !prevBtn || !nextBtn || !sliderContainer) return;
        
        let position = 0;
        const scrollAmount = 300;
        const totalWidth = slider.scrollWidth;
        const visibleWidth = sliderContainer.offsetWidth;
        const maxPosition = Math.max(0, totalWidth - visibleWidth);
        
        function updateSliderPosition() {
          slider.style.transform = `translateX(-${position}px)`;
          
          prevBtn.disabled = position === 0;
          nextBtn.disabled = position >= maxPosition;
          
          prevBtn.style.opacity = position === 0 ? '0.5' : '1';
          nextBtn.style.opacity = position >= maxPosition ? '0.5' : '1';
        }
        
        function checkScrollNeeded() {
          if (totalWidth <= visibleWidth) {
            prevBtn.style.display = 'none';
            nextBtn.style.display = 'none';
          } else {
            prevBtn.style.display = 'flex';
            nextBtn.style.display = 'flex';
          }
        }
        
        prevBtn.addEventListener('click', () => {
          position = Math.max(0, position - scrollAmount);
          updateSliderPosition();
        });
        
        nextBtn.addEventListener('click', () => {
          position = Math.min(maxPosition, position + scrollAmount);
          updateSliderPosition();
        });
        
        updateSliderPosition();
        checkScrollNeeded();
        
        window.addEventListener('resize', () => {
          const newVisibleWidth = sliderContainer.offsetWidth;
          const newMaxPosition = Math.max(0, slider.scrollWidth - newVisibleWidth);
          position = Math.min(position, newMaxPosition);
          updateSliderPosition();
          checkScrollNeeded();
        });
        
        let touchStartX = 0;
        let touchEndX = 0;
        
        sliderContainer.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        
        sliderContainer.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          handleSwipe();
        }, { passive: true });
        
        function handleSwipe() {
          const swipeDistance = touchStartX - touchEndX;
          const swipeThreshold = 50;
          
          if (swipeDistance > swipeThreshold) {
            position = Math.min(maxPosition, position + scrollAmount);
            updateSliderPosition();
          } else if (swipeDistance < -swipeThreshold) {
            position = Math.max(0, position - scrollAmount);
            updateSliderPosition();
          }
        }
      });

      function showToast(message, type = 'success') {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-4 sm:bottom-4 right-2 sm:right-4 ${type === 'success' ? 'bg-[#2C2C2C]' : 'bg-red-500'} text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg shadow-xl transform translate-y-0 opacity-100 transition-all duration-300 z-50 flex items-center text-sm sm:text-base max-w-[calc(100%-1rem)] sm:max-w-md`;
        
        const icon = document.createElement('span');
        icon.className = 'mr-2 flex-shrink-0';
        icon.innerHTML = type === 'success' 
          ? '<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>'
          : '<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
        
        const text = document.createElement('span');
        text.textContent = message;
        text.className = 'font-montserrat text-sm sm:text-base flex-1 break-words';
        
        toast.appendChild(icon);
        toast.appendChild(text);
        document.body.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('translate-y-full', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }
      
      async function addToCart(productId) {
        try {
          const response = await fetch('/add-to-cart', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ productId }),
          });

          const data = await response.json();

          if (data.success) {
            showToast('Added to cart successfully!', 'success');
            
            // Update cart count in both desktop and mobile views
            if (data.cartCount) {
              document.querySelectorAll('#cart-count, .mobile-cart-count').forEach(el => {
                el.textContent = data.cartCount;
                el.classList.remove('hidden');
              });
            }
          } else {
            throw new Error(data.message || 'Failed to add to cart');
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          showToast(error.message || 'Failed to add to cart', 'error');
        }
      }

      function setPolaroidImage(imageId, imageUrl, altText = '') {
        const imageElement = document.getElementById(imageId);
        if (imageElement) {
          imageElement.src = imageUrl;
          if (altText) {
            imageElement.alt = altText;
          }
          imageElement.onerror = function() {
            this.src = '/Images/placeholder.jpg';
          };
        }
      }
      
      function loadRandomShopImages() {
        const productImages = Array.from(document.querySelectorAll('.product-image'))
          .map(img => img.src)
          .filter(src => !src.includes('placeholder.jpg'));
        
        if (productImages.length === 0) {
          setPolaroidImage('polaroid-main', '/Images/placeholder.jpg', 'Vintage Collection');
          setPolaroidImage('polaroid-left', '/Images/placeholder.jpg', 'Retro Finds');
          setPolaroidImage('polaroid-right', '/Images/placeholder.jpg', 'Unique Pieces');
          return;
        }
        
        const shuffledImages = [...productImages].sort(() => 0.5 - Math.random());
        
        setPolaroidImage('polaroid-main', shuffledImages[0] || productImages[0], 'Vintage Collection');
        setPolaroidImage('polaroid-left', shuffledImages[1] || productImages[0], 'Retro Finds');
        setPolaroidImage('polaroid-right', shuffledImages[2] || productImages[0], 'Unique Pieces');
        
        addVintageDateStamp();
      }
      
      function addVintageDateStamp() {
        const vintageYears = ['1979', '1983', '1985', '1991', '1995', '1997'];
        const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
        const days = Array.from({length: 28}, (_, i) => i + 1);
        
        const polaroids = document.querySelectorAll('.polaroid-container');
        
        polaroids.forEach(polaroid => {
          const dateStamp = document.createElement('div');
          
          const month = months[Math.floor(Math.random() * months.length)];
          const day = days[Math.floor(Math.random() * days.length)];
          const year = vintageYears[Math.floor(Math.random() * vintageYears.length)];
          
          dateStamp.innerHTML = `${day} ${month} ${year}`;
          dateStamp.style.position = 'absolute';
          dateStamp.style.bottom = '0.5rem';
          dateStamp.style.right = '1rem';
          dateStamp.style.fontSize = '0.65rem';
          dateStamp.style.fontFamily = 'monospace';
          dateStamp.style.color = 'rgba(0,0,0,0.5)';
          dateStamp.style.transform = 'rotate(-2deg)';
          
          polaroid.appendChild(dateStamp);
        });
      }
    </script>
  </body>
</html>
