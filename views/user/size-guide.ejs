<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Size Guide | REVIVO</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
<%- include('../partials/user/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 lg:py-20">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-center mb-8 md:mb-12 text-[#2C2C2C]">Size Guide</h1>
    
    <div class="mb-12 md:mb-16">
      <p class="text-gray-700 mb-6 leading-relaxed text-center max-w-3xl mx-auto">
        Finding the right fit is essential for both comfort and style. Use our comprehensive size guides below to find your perfect size in REVIVO clothing.
      </p>
      
      <div class="bg-gray-50 p-6 rounded-lg shadow-sm mb-8">
        <h2 class="text-xl font-semibold mb-4 text-[#2C2C2C]">How to Measure</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="relative">
            <div class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-lg p-6 h-full flex items-center justify-center">
              <div class="relative w-full max-w-[250px] mx-auto">
                <!-- Stylized human figure silhouette -->
                <div class="relative mx-auto" style="height: 300px;">
                  <!-- Head -->
                  <div class="absolute w-16 h-16 bg-[#2C2C2C] rounded-full left-1/2 transform -translate-x-1/2" style="top: 0;"></div>
                  
                  <!-- Body -->
                  <div class="absolute w-32 h-40 bg-[#2C2C2C] rounded-2xl left-1/2 transform -translate-x-1/2" style="top: 20px;"></div>
                  
                  <!-- Arms -->
                  <div class="absolute w-10 h-32 bg-[#2C2C2C] rounded-full" style="top: 30px; left: 25%;"></div>
                  <div class="absolute w-10 h-32 bg-[#2C2C2C] rounded-full" style="top: 30px; right: 25%;"></div>
                  
                  <!-- Legs -->
                  <div class="absolute w-12 h-40 bg-[#2C2C2C] rounded-full" style="top: 65px; left: 35%;"></div>
                  <div class="absolute w-12 h-40 bg-[#2C2C2C] rounded-full" style="top: 65px; right: 35%;"></div>
                  
                  <!-- Measurement Lines -->
                  <!-- Chest measurement -->
                  <div class="absolute left-0 right-0 flex items-center justify-between" style="top: 40px;">
                    <div class="w-full border-t-2 border-dashed border-red-500 relative">
                      <span class="absolute -top-6 left-0 text-xs font-medium bg-white px-1 rounded text-red-500">1</span>
                    </div>
                  </div>
                  
                  <!-- Waist measurement -->
                  <div class="absolute left-0 right-0 flex items-center justify-between" style="top: 80px;">
                    <div class="w-full border-t-2 border-dashed border-blue-500 relative">
                      <span class="absolute -top-6 left-0 text-xs font-medium bg-white px-1 rounded text-blue-500">2</span>
                    </div>
                  </div>
                  
                  <!-- Hip measurement -->
                  <div class="absolute left-0 right-0 flex items-center justify-between" style="top: 120px;">
                    <div class="w-full border-t-2 border-dashed border-green-500 relative">
                      <span class="absolute -top-6 left-0 text-xs font-medium bg-white px-1 rounded text-green-500">3</span>
                    </div>
                  </div>
                  
                  <!-- Inseam measurement -->
                  <div class="absolute left-[45%] w-0 border-l-2 border-dashed border-purple-500 h-32" style="top: 140px;">
                    <span class="absolute -left-6 top-1/2 text-xs font-medium bg-white px-1 rounded text-purple-500">4</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div>
            <ul class="space-y-3">
              <li class="flex items-start">
                <span class="bg-[#2C2C2C] text-white w-6 h-6 rounded-full flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">1</span>
                <div>
                  <strong class="text-[#2C2C2C]">Chest/Bust:</strong>
                  <p class="text-gray-700">Measure around the fullest part of your chest/bust, keeping the tape horizontal.</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="bg-[#2C2C2C] text-white w-6 h-6 rounded-full flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">2</span>
                <div>
                  <strong class="text-[#2C2C2C]">Waist:</strong>
                  <p class="text-gray-700">Measure around your natural waistline, keeping the tape comfortably loose.</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="bg-[#2C2C2C] text-white w-6 h-6 rounded-full flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">3</span>
                <div>
                  <strong class="text-[#2C2C2C]">Hips:</strong>
                  <p class="text-gray-700">Measure around the fullest part of your hips, approximately 8" below your waistline.</p>
                </div>
              </li>
              <li class="flex items-start">
                <span class="bg-[#2C2C2C] text-white w-6 h-6 rounded-full flex items-center justify-center mr-3 mt-0.5 flex-shrink-0">4</span>
                <div>
                  <strong class="text-[#2C2C2C]">Inseam:</strong>
                  <p class="text-gray-700">Measure from the crotch to the bottom of the leg.</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
      
      <!-- Size Chart Tabs -->
      <div class="mb-8">
        <div class="border-b border-gray-200">
          <nav class="flex -mb-px" aria-label="Tabs">
            <button class="size-tab-button active py-4 px-1 border-b-2 font-medium text-sm border-[#2C2C2C] text-[#2C2C2C] whitespace-nowrap mx-6" data-target="tops">
              Tops & Shirts
            </button>
            <button class="size-tab-button py-4 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap mx-6" data-target="bottoms">
              Bottoms
            </button>
            <button class="size-tab-button py-4 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap mx-6" data-target="outerwear">
              Outerwear
            </button>
          </nav>
        </div>
        
        <!-- Tops Size Chart -->
        <div id="tops" class="size-tab-content py-6">
          <h3 class="text-lg font-medium mb-4 text-[#2C2C2C]">Tops & Shirts (inches)</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full border border-gray-200">
              <thead>
                <tr class="bg-gray-50">
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Size</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Chest</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Waist</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Shoulder</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Sleeve Length</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">XS</td>
                  <td class="px-4 py-3 text-sm text-gray-700">34-36</td>
                  <td class="px-4 py-3 text-sm text-gray-700">28-30</td>
                  <td class="px-4 py-3 text-sm text-gray-700">16.5</td>
                  <td class="px-4 py-3 text-sm text-gray-700">23.5</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">S</td>
                  <td class="px-4 py-3 text-sm text-gray-700">36-38</td>
                  <td class="px-4 py-3 text-sm text-gray-700">30-32</td>
                  <td class="px-4 py-3 text-sm text-gray-700">17</td>
                  <td class="px-4 py-3 text-sm text-gray-700">24</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">M</td>
                  <td class="px-4 py-3 text-sm text-gray-700">38-40</td>
                  <td class="px-4 py-3 text-sm text-gray-700">32-34</td>
                  <td class="px-4 py-3 text-sm text-gray-700">17.5</td>
                  <td class="px-4 py-3 text-sm text-gray-700">24.5</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">L</td>
                  <td class="px-4 py-3 text-sm text-gray-700">40-42</td>
                  <td class="px-4 py-3 text-sm text-gray-700">34-36</td>
                  <td class="px-4 py-3 text-sm text-gray-700">18</td>
                  <td class="px-4 py-3 text-sm text-gray-700">25</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">XL</td>
                  <td class="px-4 py-3 text-sm text-gray-700">42-44</td>
                  <td class="px-4 py-3 text-sm text-gray-700">36-38</td>
                  <td class="px-4 py-3 text-sm text-gray-700">18.5</td>
                  <td class="px-4 py-3 text-sm text-gray-700">25.5</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">XXL</td>
                  <td class="px-4 py-3 text-sm text-gray-700">44-46</td>
                  <td class="px-4 py-3 text-sm text-gray-700">38-40</td>
                  <td class="px-4 py-3 text-sm text-gray-700">19</td>
                  <td class="px-4 py-3 text-sm text-gray-700">26</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        
        <!-- Bottoms Size Chart -->
        <div id="bottoms" class="size-tab-content py-6 hidden">
          <h3 class="text-lg font-medium mb-4 text-[#2C2C2C]">Bottoms (inches)</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full border border-gray-200">
              <thead>
                <tr class="bg-gray-50">
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Size</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Waist</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Hip</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Inseam (Regular)</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">28</td>
                  <td class="px-4 py-3 text-sm text-gray-700">28-29</td>
                  <td class="px-4 py-3 text-sm text-gray-700">35-36</td>
                  <td class="px-4 py-3 text-sm text-gray-700">32</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">30</td>
                  <td class="px-4 py-3 text-sm text-gray-700">30-31</td>
                  <td class="px-4 py-3 text-sm text-gray-700">37-38</td>
                  <td class="px-4 py-3 text-sm text-gray-700">32</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">32</td>
                  <td class="px-4 py-3 text-sm text-gray-700">32-33</td>
                  <td class="px-4 py-3 text-sm text-gray-700">39-40</td>
                  <td class="px-4 py-3 text-sm text-gray-700">32</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">34</td>
                  <td class="px-4 py-3 text-sm text-gray-700">34-35</td>
                  <td class="px-4 py-3 text-sm text-gray-700">41-42</td>
                  <td class="px-4 py-3 text-sm text-gray-700">32</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">36</td>
                  <td class="px-4 py-3 text-sm text-gray-700">36-37</td>
                  <td class="px-4 py-3 text-sm text-gray-700">43-44</td>
                  <td class="px-4 py-3 text-sm text-gray-700">32</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">38</td>
                  <td class="px-4 py-3 text-sm text-gray-700">38-39</td>
                  <td class="px-4 py-3 text-sm text-gray-700">45-46</td>
                  <td class="px-4 py-3 text-sm text-gray-700">32</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        
        <!-- Outerwear Size Chart -->
        <div id="outerwear" class="size-tab-content py-6 hidden">
          <h3 class="text-lg font-medium mb-4 text-[#2C2C2C]">Outerwear (inches)</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full border border-gray-200">
              <thead>
                <tr class="bg-gray-50">
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Size</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Chest</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Shoulder</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Sleeve Length</th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider border-b">Length</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">XS</td>
                  <td class="px-4 py-3 text-sm text-gray-700">36-38</td>
                  <td class="px-4 py-3 text-sm text-gray-700">17</td>
                  <td class="px-4 py-3 text-sm text-gray-700">24</td>
                  <td class="px-4 py-3 text-sm text-gray-700">26</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">S</td>
                  <td class="px-4 py-3 text-sm text-gray-700">38-40</td>
                  <td class="px-4 py-3 text-sm text-gray-700">17.5</td>
                  <td class="px-4 py-3 text-sm text-gray-700">24.5</td>
                  <td class="px-4 py-3 text-sm text-gray-700">27</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">M</td>
                  <td class="px-4 py-3 text-sm text-gray-700">40-42</td>
                  <td class="px-4 py-3 text-sm text-gray-700">18</td>
                  <td class="px-4 py-3 text-sm text-gray-700">25</td>
                  <td class="px-4 py-3 text-sm text-gray-700">28</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">L</td>
                  <td class="px-4 py-3 text-sm text-gray-700">42-44</td>
                  <td class="px-4 py-3 text-sm text-gray-700">18.5</td>
                  <td class="px-4 py-3 text-sm text-gray-700">25.5</td>
                  <td class="px-4 py-3 text-sm text-gray-700">29</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">XL</td>
                  <td class="px-4 py-3 text-sm text-gray-700">44-46</td>
                  <td class="px-4 py-3 text-sm text-gray-700">19</td>
                  <td class="px-4 py-3 text-sm text-gray-700">26</td>
                  <td class="px-4 py-3 text-sm text-gray-700">30</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 text-sm font-medium text-gray-900">XXL</td>
                  <td class="px-4 py-3 text-sm text-gray-700">46-48</td>
                  <td class="px-4 py-3 text-sm text-gray-700">19.5</td>
                  <td class="px-4 py-3 text-sm text-gray-700">26.5</td>
