            <% brands.forEach(brand => { %>
              <a href="/shop/brand/<%= brand._id %>" class="brand-item group">
                <div class="w-32 h-32 bg-gray-50 rounded-lg flex items-center justify-center p-4 transition-all duration-300 hover:shadow-lg">
                  <% if (brand.brandImage && brand.brandImage[0]) { %>
                    <img src="<%= brand.brandImage[0] %>" alt="<%= brand.brandName %> Vintage" class="w-24 h-auto opacity-70 group-hover:opacity-100" onerror="this.src='/Images/placeholder.jpg'">
                  <% } else { %>
                    <span class="text-2xl font-henny text-[#2C2C2C]/70 group-hover:text-[#2C2C2C]"><%= brand.brandName.charAt(0).toUpperCase() %></span>
                  <% } %>
                </div>
                <p class="text-center mt-2 text-[#2C2C2C]/70 group-hover:text-[#2C2C2C] font-montserrat"><%= brand.brandName %></p>
              </a>
            <% }); %>
          <% } else { %>
            <div class="text-center py-12 w-full">
              <p class="text-[#2C2C2C]/70 font-montserrat">No brands available at the moment.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
    
    <% if (brands && brands.length > 4) { %>
    <!-- Brand pagination dots -->
    <div class="brand-pagination flex justify-center mt-6 gap-1"></div>

    <!-- Brand slider JavaScript -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const brandSlider = document.querySelector('.brands-slider');
        const prevBrandBtn = document.getElementById('prev-brand');
        const nextBrandBtn = document.getElementById('next-brand');
        const brandContainer = document.querySelector('.brands-slider-container');
        const brandPagination = document.querySelector('.brand-pagination');
        
        if (!brandSlider || !prevBrandBtn || !nextBrandBtn || !brandContainer || !brandPagination) return;
        
        // Count the number of brand elements
        const brandElements = brandSlider.querySelectorAll('.brand-item');
        // How many brands to show per page
        const brandsPerPage = 4;
        const totalBrands = brandElements.length;
        const numPages = Math.ceil(totalBrands / brandsPerPage);
        
        let currentPage = 0;
        
        // Create pagination dots
        for (let i = 0; i < numPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('pagination-dot', 'w-2', 'h-2', 'rounded-full', 'bg-[#e0dcd4]', 'hover:bg-[#f8c78d]', 'transition-colors');
          if (i === 0) dot.classList.add('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
          dot.setAttribute('data-index', i);
          dot.addEventListener('click', () => {
            goToPage(i);
          });
          brandPagination.appendChild(dot);
        }
        
        function updatePaginationDots() {
          document.querySelectorAll('.brand-pagination .pagination-dot').forEach((dot, index) => {
            if (index === currentPage) {
              dot.classList.add('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
            } else {
              dot.classList.remove('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
              dot.classList.add('w-2', 'h-2', 'bg-[#e0dcd4]');
            }
          });
        }
        
        function goToPage(pageIndex) {
          currentPage = pageIndex;
          
          // Show only 4 brands per page
          brandElements.forEach((brand, index) => {
            const startIdx = pageIndex * brandsPerPage;
            const endIdx = startIdx + brandsPerPage - 1;
            
            if (index >= startIdx && index <= endIdx) {
              brand.classList.remove('hidden');
            } else {
              brand.classList.add('hidden');
            }
          });
          
          // Update buttons state
          prevBrandBtn.disabled = currentPage === 0;
          nextBrandBtn.disabled = currentPage === numPages - 1;
          
          prevBrandBtn.style.opacity = currentPage === 0 ? '0.5' : '1';
          nextBrandBtn.style.opacity = currentPage === numPages - 1 ? '0.5' : '1';
          
          updatePaginationDots();
        }
        
        prevBrandBtn.addEventListener('click', () => {
          if (currentPage > 0) {
            goToPage(currentPage - 1);
          }
        });
        
        nextBrandBtn.addEventListener('click', () => {
          if (currentPage < numPages - 1) {
            goToPage(currentPage + 1);
          }
        });
        
        // Initialize - show only first page
        goToPage(0);
        
        // Touch events for mobile swipe
        let touchStartX = 0;
        let touchEndX = 0;
        
        brandContainer.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        
        brandContainer.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          handleSwipe();
        }, { passive: true });
        
        function handleSwipe() {
          const swipeDistance = touchStartX - touchEndX;
          const swipeThreshold = 50; // Minimum distance to trigger swipe
          
          if (swipeDistance > swipeThreshold) {
            // Swipe left - go right
            if (currentPage < numPages - 1) {
              goToPage(currentPage + 1);
            }
          } else if (swipeDistance < -swipeThreshold) {
            // Swipe right - go left
            if (currentPage > 0) {
              goToPage(currentPage - 1);
            }
          }
        }
      });
    </script>
    <% } %>

    <p class="text-center text-[#2C2C2C]/50 mt-12 max-w-2xl mx-auto text-sm font-montserrat">
      Our collection features branded vintage pieces carefully selected for their quality, character, and timeless appeal.
    </p>
  </div>
</section>

