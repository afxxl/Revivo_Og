<section class="relative py-10 sm:py-12 md:py-16 overflow-hidden bg-white">
  <div class="container mx-auto px-4 max-w-7xl relative">
    <div class="text-center mb-8 md:mb-12">
      <h2 class="text-2xl sm:text-3xl font-henny text-[#2C2C2C] mb-2 sm:mb-4">Shop By Category</h2>
      <p class="text-[#2C2C2C]/70 font-montserrat text-sm sm:text-base">Discover our curated vintage collections</p>
    </div>

    <% 
      const categoriesWithOffers = categories.filter(category => category.categoryOffer && category.categoryOffer > 0);
      if (categoriesWithOffers.length > 0) { 
    %>
    <div class="mb-12 bg-white p-6 rounded-lg shadow-sm border border-[#f8c78d]/30">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xl font-henny text-[#2C2C2C]">Special Offers</h3>
        <div class="flex items-center gap-2">
          <button id="prev-offer" class="w-8 h-8 flex items-center justify-center bg-[#f8f7f5] rounded-full hover:bg-[#f8c78d]/20 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
          </button>
          <button id="next-offer" class="w-8 h-8 flex items-center justify-center bg-[#f8f7f5] rounded-full hover:bg-[#f8c78d]/20 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>
      
      <div class="offer-slider-container relative overflow-hidden">
        <div class="offer-slider flex gap-4 items-center transition-transform duration-300" style="transform: translateX(0);">
          <% categoriesWithOffers.forEach(category => { %>
            <a href="/shop?category=<%= category._id %>" class="flex-shrink-0 group flex items-center gap-2 bg-[#f8f7f5] hover:bg-[#f8c78d]/20 px-4 py-2 rounded-full border border-[#e0dcd4] transition-all duration-300">
              <span class="text-[#2C2C2C] font-montserrat text-sm whitespace-nowrap"><%= category.name %></span>
              <span class="bg-[#f8c78d] text-[#2C2C2C] px-2 py-0.5 rounded-full text-xs font-semibold whitespace-nowrap"><%= category.categoryOffer %>% OFF</span>
            </a>
          <% }); %>
        </div>
      </div>
      
      <div class="slider-pagination flex justify-center mt-4 gap-1"></div>
    </div>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const slider = document.querySelector('.offer-slider');
        const prevBtn = document.getElementById('prev-offer');
        const nextBtn = document.getElementById('next-offer');
        const sliderContainer = document.querySelector('.offer-slider-container');
        const pagination = document.querySelector('.slider-pagination');
        
        if (!slider || !prevBtn || !nextBtn || !sliderContainer || !pagination) return;
        
        let position = 0;
        const itemWidth = 180; // Approximate width of each item including gap
        const visibleWidth = sliderContainer.offsetWidth;
        const totalWidth = slider.scrollWidth;
        const maxPosition = Math.max(0, totalWidth - visibleWidth);
        
        // Calculate how many pages we need
        const numItems = slider.children.length;
        const itemsPerPage = Math.floor(visibleWidth / itemWidth);
        const numPages = Math.ceil(numItems / itemsPerPage);
        
        // Create pagination dots
        for (let i = 0; i < numPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('pagination-dot', 'w-2', 'h-2', 'rounded-full', 'bg-[#e0dcd4]', 'hover:bg-[#f8c78d]', 'transition-colors');
          if (i === 0) dot.classList.add('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
          dot.setAttribute('data-index', i);
          dot.addEventListener('click', () => {
            // Calculate position based on page index
            position = Math.min(maxPosition, i * (itemsPerPage * itemWidth));
            updateSliderPosition();
            updatePaginationDots();
          });
          pagination.appendChild(dot);
        }
        
        function updatePaginationDots() {
          // Determine which page we're on
          const currentPage = Math.floor(position / (itemsPerPage * itemWidth));
          
          // Update dots
          document.querySelectorAll('.pagination-dot').forEach((dot, index) => {
            if (index === currentPage) {
              dot.classList.add('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
            } else {
              dot.classList.remove('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
              dot.classList.add('w-2', 'h-2', 'bg-[#e0dcd4]');
            }
          });
        }
        
        function updateSliderPosition() {
          slider.style.transform = `translateX(-${position}px)`;
          
          // Disable buttons when at the start or end
          prevBtn.disabled = position === 0;
          nextBtn.disabled = position >= maxPosition;
          
          prevBtn.style.opacity = position === 0 ? '0.5' : '1';
          nextBtn.style.opacity = position >= maxPosition ? '0.5' : '1';
          
          // Update pagination dots
          updatePaginationDots();
        }
        
        prevBtn.addEventListener('click', () => {
          position = Math.max(0, position - (itemsPerPage * itemWidth));
          updateSliderPosition();
        });
        
        nextBtn.addEventListener('click', () => {
          position = Math.min(maxPosition, position + (itemsPerPage * itemWidth));
          updateSliderPosition();
        });
        
        // Initialize button states
        updateSliderPosition();
        
        // Update on window resize
        window.addEventListener('resize', () => {
          const newVisibleWidth = sliderContainer.offsetWidth;
          const newMaxPosition = Math.max(0, slider.scrollWidth - newVisibleWidth);
          const newItemsPerPage = Math.floor(newVisibleWidth / itemWidth);
          
          // Rebuild pagination if needed
          if (newItemsPerPage !== itemsPerPage) {
            // Clear pagination and rebuild it
            pagination.innerHTML = '';
            const newNumPages = Math.ceil(numItems / newItemsPerPage);
            for (let i = 0; i < newNumPages; i++) {
              const dot = document.createElement('button');
              dot.classList.add('pagination-dot', 'w-2', 'h-2', 'rounded-full', 'bg-[#e0dcd4]', 'hover:bg-[#f8c78d]', 'transition-colors');
              dot.setAttribute('data-index', i);
              dot.addEventListener('click', () => {
                position = Math.min(newMaxPosition, i * (newItemsPerPage * itemWidth));
                updateSliderPosition();
                updatePaginationDots();
              });
              pagination.appendChild(dot);
            }
          }
          
          position = Math.min(position, newMaxPosition);
          updateSliderPosition();
        });
        
        // Touch events for mobile swipe
        let touchStartX = 0;
        let touchEndX = 0;
        
        sliderContainer.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        
        sliderContainer.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          handleSwipe();
        }, { passive: true });
        
        function handleSwipe() {
          const swipeDistance = touchStartX - touchEndX;
          const swipeThreshold = 50; // Minimum distance to trigger swipe
          
          if (swipeDistance > swipeThreshold) {
            // Swipe left - go right
            if (position < maxPosition) {
              position = Math.min(maxPosition, position + (itemsPerPage * itemWidth));
              updateSliderPosition();
            }
          } else if (swipeDistance < -swipeThreshold) {
            // Swipe right - go left
            if (position > 0) {
              position = Math.max(0, position - (itemsPerPage * itemWidth));
              updateSliderPosition();
            }
          }
        }
      });
    </script>
    <% } %>

    <% if (categories.length > 6) { %>
    <!-- Category slider navigation buttons -->
    <div class="flex justify-end mb-4">
      <div class="flex items-center gap-2">
        <button id="prev-category" class="w-8 h-8 flex items-center justify-center bg-[#f8f7f5] rounded-full hover:bg-[#f8c78d]/20 transition-colors border border-[#e0dcd4]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button id="next-category" class="w-8 h-8 flex items-center justify-center bg-[#f8f7f5] rounded-full hover:bg-[#f8c78d]/20 transition-colors border border-[#e0dcd4]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
    <% } %>

    <!-- Category grid/slider -->
    <div class="category-slider-container overflow-hidden">
      <div class="category-slider <%= categories.length > 6 ? 'transition-transform duration-300' : '' %>" style="transform: translateX(0);">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% categories.forEach(category => { %>
            <div class="group relative overflow-hidden border <%= category.categoryOffer && category.categoryOffer > 0 ? 'border-[#f8c78d]' : 'border-[#e0dcd4]' %> rounded-lg <%= category.categoryOffer && category.categoryOffer > 0 ? 'shadow-md' : '' %>">
              <div class="aspect-[4/3] relative overflow-hidden">
                <img src="<%= category.image || '/Images/placeholder.jpg' %>" 
                     alt="<%= category.name %>" 
                     class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                <div class="absolute inset-0 bg-black/40 group-hover:bg-black/50 transition-all duration-300"></div>
                <% if (category.categoryOffer && category.categoryOffer > 0) { %>
                  <div class="absolute top-4 right-4 bg-[#f8c78d] text-[#2C2C2C] rounded-full px-3 py-1 text-xs font-bold z-10 shadow-md">
                    <%= category.categoryOffer %>% OFF
                  </div>
                <% } %>
                <div class="absolute inset-0 flex flex-col items-center justify-center text-white">
                  <h3 class="text-2xl font-henny mb-2"><%= category.name %></h3>
                  <p class="text-sm uppercase tracking-wider mb-4 font-montserrat">
                    <% if (category.name === 'Timeless Trousers') { %>
                      Pants • Jeans • Tracks
                    <% } else if (category.name === 'Heritage Shirts') { %>
                      Formal • Casual • Vintage
                    <% } else if (category.name === 'Matchday Classics') { %>
                      Jerseys • Training • Sports
                    <% } else if (category.name === 'Vintage Tees') { %>
                      T-Shirts • Polos • Graphics
                    <% } else if (category.name === 'Outerwear') { %>
                      Jackets • Hoodies • Sweaters
                    <% } else if (category.name === 'Accessories') { %>
                      Caps • Bags • Belts
                    <% } else { %>
                      Vintage Collection
                    <% } %>
                  </p>
                  <% if (category.categoryOffer && category.categoryOffer > 0) { %>
                    <span class="px-4 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold mb-3">
                      Save <%= category.categoryOffer %>% on all items
                    </span>
                  <% } %>
                  <a href="/shop?category=<%= category._id %>" 
                     class="<%= category.categoryOffer && category.categoryOffer > 0 ? 'bg-[#f8c78d] text-[#2C2C2C] border-[#f8c78d]' : 'border border-white hover:bg-white hover:text-[#2C2C2C]' %> px-6 py-2 transition-all duration-300 font-montserrat">
                    Shop Now
                  </a>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

    <% if (categories.length > 6) { %>
    <!-- Category pagination dots -->
    <div class="category-pagination flex justify-center mt-6 gap-1"></div>

    <!-- Category slider JavaScript -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const categorySlider = document.querySelector('.category-slider');
        const prevCategoryBtn = document.getElementById('prev-category');
        const nextCategoryBtn = document.getElementById('next-category');
        const categoryContainer = document.querySelector('.category-slider-container');
        const categoryPagination = document.querySelector('.category-pagination');
        
        if (!categorySlider || !prevCategoryBtn || !nextCategoryBtn || !categoryContainer || !categoryPagination) return;
        
        // Count the number of category elements
        const categoryElements = categorySlider.querySelectorAll('.grid > div');
        // How many categories to show per page
        const categoriesPerPage = 6;
        const totalCategories = categoryElements.length;
        const numPages = Math.ceil(totalCategories / categoriesPerPage);
        
        let currentPage = 0;
        
        // Create pagination dots
        for (let i = 0; i < numPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('pagination-dot', 'w-2', 'h-2', 'rounded-full', 'bg-[#e0dcd4]', 'hover:bg-[#f8c78d]', 'transition-colors');
          if (i === 0) dot.classList.add('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
          dot.setAttribute('data-index', i);
          dot.addEventListener('click', () => {
            goToPage(i);
          });
          categoryPagination.appendChild(dot);
        }
        
        function updatePaginationDots() {
          document.querySelectorAll('.category-pagination .pagination-dot').forEach((dot, index) => {
            if (index === currentPage) {
              dot.classList.add('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
            } else {
              dot.classList.remove('active', 'bg-[#f8c78d]', 'w-3', 'h-3');
              dot.classList.add('w-2', 'h-2', 'bg-[#e0dcd4]');
            }
          });
        }
        
        function goToPage(pageIndex) {
          currentPage = pageIndex;
          
          // Show only 6 categories per page
          categoryElements.forEach((category, index) => {
            const startIdx = pageIndex * categoriesPerPage;
            const endIdx = startIdx + categoriesPerPage - 1;
            
            if (index >= startIdx && index <= endIdx) {
              category.classList.remove('hidden');
            } else {
              category.classList.add('hidden');
            }
          });
          
          // Update buttons state
          prevCategoryBtn.disabled = currentPage === 0;
          nextCategoryBtn.disabled = currentPage === numPages - 1;
          
          prevCategoryBtn.style.opacity = currentPage === 0 ? '0.5' : '1';
          nextCategoryBtn.style.opacity = currentPage === numPages - 1 ? '0.5' : '1';
          
          updatePaginationDots();
        }
        
        prevCategoryBtn.addEventListener('click', () => {
          if (currentPage > 0) {
            goToPage(currentPage - 1);
          }
        });
        
        nextCategoryBtn.addEventListener('click', () => {
          if (currentPage < numPages - 1) {
            goToPage(currentPage + 1);
          }
        });
        
        // Initialize - show only first page
        goToPage(0);
        
        // Touch events for mobile swipe
        let touchStartX = 0;
        let touchEndX = 0;
        
        categoryContainer.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        
        categoryContainer.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          handleSwipe();
        }, { passive: true });
        
        function handleSwipe() {
          const swipeDistance = touchStartX - touchEndX;
          const swipeThreshold = 50; // Minimum distance to trigger swipe
          
          if (swipeDistance > swipeThreshold) {
            // Swipe left - go right
            if (currentPage < numPages - 1) {
              goToPage(currentPage + 1);
            }
          } else if (swipeDistance < -swipeThreshold) {
            // Swipe right - go left
            if (currentPage > 0) {
              goToPage(currentPage - 1);
            }
          }
        }
      });
    </script>
    <% } %>
  </div>
</section>

