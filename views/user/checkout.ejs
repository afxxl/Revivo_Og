<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - REVIVO</title>
    <link href="/css/styles.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        .checkout-section {
            background-image: url('/Images/images/OLD_PAPER_TEXTURE.jpg');
            background-size: cover;
            background-position: center;
        }
        .address-card {
            transition: all 0.3s ease;
            cursor: pointer;
            border: 2px solid transparent;
            position: relative;
        }
        .address-card:hover {
            border-color: #f8c78d;
        }
        .address-card.selected {
            border-color: #2C2C2C;
            background-color: rgba(44, 44, 44, 0.05);
        }
        .payment-method {
            transition: all 0.3s ease;
            border: 2px solid transparent;
            cursor: pointer;
        }
        .payment-method:hover {
            border-color: #f8c78d;
        }
        .payment-method.selected {
            border-color: #2C2C2C;
            background-color: rgba(44, 44, 44, 0.05);
        }
        .edit-address-btn {
            position: absolute;
            bottom: 8px;
            right: 8px;
            padding: 2px 8px;
            background: rgba(44, 44, 44, 0.1);
            border-radius: 4px;
            display: none;
        }
        .address-card:hover .edit-address-btn {
            display: block;
        }
    </style>
</head>

<body class="checkout-section">
    <%- include('../partials/user/header.ejs') %>
    <%- include('../partials/user/address-modal.ejs') %>

    <div class="container mx-auto px-4 py-6 sm:py-8 md:py-10 lg:py-12 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
            <div class="space-y-6 md:space-y-8">
                <div class="bg-white/80 p-4 sm:p-5 md:p-6 rounded-lg shadow-sm">
                    <h2 class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6">Delivery Information</h2>
                    
                    <div class="mb-4 sm:mb-6">
                        <h3 class="text-base sm:text-lg font-medium mb-3 sm:mb-4">Select Address</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4" id="addressContainer">
                            <% if (user && user.addresses && user.addresses.length > 0) { %>
                                <% user.addresses.forEach(address => { %>
                                    <div class="address-card p-3 sm:p-4 rounded-lg border bg-white relative"
                                        data-address-id="<%= address._id %>"
                                        onclick="selectAddress(this)">
                                    <% if (address.isDefault) { %>
                                        <span class="absolute top-2 right-2 bg-[#f8c78d] text-xs px-1.5 sm:px-2 py-0.5 sm:py-1 rounded">Default</span>
                                    <% } %>
                                    <button 
                                        class="edit-address-btn text-xs sm:text-sm"
                                        onclick="event.stopPropagation(); editAddress('<%= address._id %>')"
                                    >
                                        <i class="fas fa-edit mr-1"></i>Edit
                                    </button>
                                    <h4 class="font-medium text-sm sm:text-base"><%= address.name %> (<%= address.addressType %>)</h4>
                                    <p class="text-xs sm:text-sm"><%= address.address %></p>
                                    <p class="text-xs sm:text-sm"><%= address.city %>, <%= address.state %> - <%= address.pincode %></p>
                                    <p class="text-xs sm:text-sm">Phone: <%= address.phone %></p>
                                </div>
                                <% }); %>
                            <% } else { %>
                                <div class="col-span-1 sm:col-span-2 p-4 bg-gray-50 rounded-lg text-center">
                                    <p class="mb-3">You don't have any saved addresses yet.</p>
                                    <p class="text-sm text-gray-500">Please add a new address using the button below.</p>
                                </div>
                            <% } %>
                        </div>
                        <button 
                            onclick="openAddressModal()"
                            class="mt-3 sm:mt-4 px-3 sm:px-4 py-1.5 sm:py-2 bg-[#2C2C2C] text-white rounded text-sm sm:text-base hover:bg-[#1a1a1a] transition-colors"
                        >
                            <i class="fas fa-plus mr-2"></i> Add New Address
                        </button>
                    </div>

                    <div class="pt-4 sm:pt-6 border-t border-gray-200">
                        <h3 class="text-base sm:text-lg font-medium mb-3 sm:mb-4">Payment Method</h3>

<!-- Inside the payment method section -->
<div class="grid grid-cols-2 gap-3 sm:gap-4">
    <% if (isCODAvailable) { %>
    <div class="payment-method p-3 sm:p-4 rounded-lg border bg-white text-center cursor-pointer"
         data-method="COD"
         onclick="selectPaymentMethod(this)">
        <i class="fas fa-money-bill-wave text-xl sm:text-2xl mb-1 sm:mb-2 text-green-500"></i>
        <p class="font-medium text-sm sm:text-base">Cash on Delivery</p>
        <p class="text-xs text-gray-500 mt-0.5 sm:mt-1">Pay when you receive</p>
    </div>
    <% } else { %>
    <div class="payment-method p-4 rounded-lg border bg-gray-100 text-center cursor-not-allowed opacity-75"
         title="Cash on Delivery is not available for orders above ₹1000">
        <i class="fas fa-money-bill-wave text-2xl mb-2 text-gray-300"></i>
        <p class="font-medium text-gray-400">Cash on Delivery</p>
        <p class="text-xs text-gray-400 mt-1">Not available (Order > ₹1000)</p>
    </div>
    <% } %>

    <% if (walletBalance >= total) { %>
    <div class="payment-method p-3 sm:p-4 rounded-lg border bg-white text-center cursor-pointer"
         data-method="WALLET"
         onclick="selectPaymentMethod(this)">
        <i class="fas fa-wallet text-xl sm:text-2xl mb-1 sm:mb-2 text-purple-500"></i>
        <p class="font-medium text-sm sm:text-base">Wallet</p>
        <p class="text-xs text-gray-500 mt-0.5 sm:mt-1">Balance: ₹<%= walletBalance.toFixed(2) %></p>
    </div>
    <% } else { %>
    <div class="payment-method p-3 sm:p-4 rounded-lg border bg-gray-100 text-center cursor-not-allowed opacity-75"
         title="Insufficient wallet balance">
        <i class="fas fa-wallet text-xl sm:text-2xl mb-1 sm:mb-2 text-purple-300"></i>
        <p class="font-medium text-sm sm:text-base">Wallet</p>
        <p class="text-xs text-gray-500 mt-0.5 sm:mt-1">Balance: ₹<%= walletBalance.toFixed(2) %></p>
        <p class="text-xs text-red-500 mt-0.5 sm:mt-1">Insufficient balance</p>
    </div>
    <% } %>

    <div class="payment-method p-3 sm:p-4 rounded-lg border bg-white text-center cursor-pointer"
         data-method="RAZORPAY"
         onclick="selectPaymentMethod(this)">
        <i class="fas fa-credit-card text-xl sm:text-2xl mb-1 sm:mb-2 text-blue-500"></i>
        <p class="font-medium text-sm sm:text-base">Razorpay</p>
        <p class="text-xs text-gray-500 mt-0.5 sm:mt-1">Credit/Debit Cards, UPI, Wallets</p>
    </div>
</div>
                                            </div>
                </div>
            </div>

            <div class="bg-white/80 p-4 sm:p-5 md:p-6 rounded-lg shadow-sm h-fit sticky top-4">
                <h2 class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6">Order Summary</h2>
                
                <div class="mb-6">
                    <% cart.items.forEach(item => { %>
                        <div class="flex items-center justify-between py-2 sm:py-3 border-b">
                            <div class="flex items-center space-x-2 sm:space-x-4">
                                <img src="<%= item.productId.productImage[0] %>" 
                                     alt="<%= item.productId.productName %>"
                                     class="w-12 h-12 sm:w-16 sm:h-16 object-contain">
                                <div>
                                    <h4 class="font-medium text-sm sm:text-base"><%= item.productId.productName %></h4>
                                    <p class="text-xs sm:text-sm text-gray-600">Qty: <%= item.quantity %></p>
                                    <% 
                                      const productOffer = item.productId.productOffer || 0;
                                      const categoryOffer = item.productId.category && item.productId.category.categoryOffer ? item.productId.category.categoryOffer : 0;
                                      const bestOfferPercentage = Math.max(productOffer, categoryOffer);
                                    %>
                                    <% if (bestOfferPercentage > 0) { %>
                                      <p class="text-xs bg-green-100 text-green-700 font-semibold px-1 sm:px-1.5 py-0.5 rounded-sm inline-block mt-0.5 sm:mt-1">
                                        Save <%= bestOfferPercentage %>%
                                      </p>
                                    <% } %>
                                </div>
                            </div>
                            <div>
                              <% if (bestOfferPercentage > 0) { %>
                                <p class="font-medium text-sm sm:text-base">₹<%= item.totalPrice.toFixed(2) %></p>
                                <p class="text-xs text-gray-500 line-through">
                                  ₹<%= (item.productId.salesPrice * item.quantity).toFixed(2) %>
                                </p>
                              <% } else { %>
                                <p class="font-medium text-sm sm:text-base">₹<%= item.totalPrice.toFixed(2) %></p>
                              <% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <div class="space-y-2 sm:space-y-3 mb-4 sm:mb-6">
                    <% 
                      let totalSavings = 0;
                      cart.items.forEach(item => {
                        const originalPrice = item.productId.salesPrice * item.quantity;
                        const discountAmount = originalPrice - item.totalPrice;
                        totalSavings += discountAmount;
                      });
                    %>
                    <div class="flex justify-between text-sm sm:text-base">
                        <span>Subtotal:</span>
                        <span>₹<%= subtotal.toFixed(2) %></span>
                    </div>
                    <% if (totalSavings > 0) { %>
                    <div class="flex justify-between text-green-600 text-sm sm:text-base">
                        <span>Total Savings:</span>
                        <span>-₹<%= totalSavings.toFixed(2) %></span>
                    </div>
                    <% } %>
                    <div class="flex justify-between text-sm sm:text-base">
                        <span>Shipping:</span>
                        <span>₹<%= shipping.toFixed(2) %></span>
                    </div>
                    
                    <% if (appliedCoupon) { %>
                    <div class="flex justify-between text-green-600 text-sm sm:text-base">
                        <span>Coupon (<%= appliedCoupon.code %>):</span>
                        <span>-₹<%= appliedCoupon.discount.toFixed(2) %></span>
                    </div>
                    <% } %>
                    
                    <div class="flex justify-between font-bold border-t pt-2 sm:pt-3 text-sm sm:text-base">
                        <span>Total:</span>
                        <span>₹<%= total.toFixed(2) %></span>
                    </div>
                </div>

                <button 
                    id="placeOrderBtn"
                    onclick="placeOrder()"
                    class="w-full py-2.5 sm:py-3 bg-[#2C2C2C] text-white rounded text-sm sm:text-base hover:bg-[#1a1a1a] transition-colors"
                >
                    Place Order
                </button>
            </div>
        </div>
    </div>

    <%- include('../partials/user/footer.ejs') %>


<script>
    let selectedAddressId = null;
    let selectedPaymentMethod = null;

    function selectAddress(element) {
        document.querySelectorAll('.address-card').forEach(card => {
            card.classList.remove('selected');
        });
        element.classList.add('selected');
        selectedAddressId = element.dataset.addressId;
    }

    function selectPaymentMethod(element) {
        if (element.classList.contains('cursor-not-allowed')) {
            return;
        }
        
        document.querySelectorAll('.payment-method').forEach(method => {
            method.classList.remove('selected');
        });
        element.classList.add('selected');
        selectedPaymentMethod = element.dataset.method;
    }

    async function editAddress(addressId) {
        try {
            const response = await fetch(`/addresses/${addressId}`);
            const address = await response.json();
            
            document.getElementById('addressId').value = address._id;
            document.getElementById('modalAddressType').value = address.addressType;
            document.getElementById('modalName').value = address.name;
            document.getElementById('modalAddress').value = address.address;
            document.getElementById('modalCity').value = address.city;
            document.getElementById('modalState').value = address.state;
            document.getElementById('modalPincode').value = address.pincode;
            document.getElementById('modalPhone').value = address.phone;
            document.getElementById('modalAltPhone').value = address.altPhone || '';
            document.getElementById('isDefault').checked = address.isDefault;

            openAddressModal(addressId);
        } catch (error) {
            console.error('Edit address error:', error);
            showToast('Failed to load address details', 'error');
        }
    }

    async function placeOrder() {
        if (!selectedAddressId) {
            showToast('Please select a delivery address', 'error');
            return;
        }

        if (!selectedPaymentMethod) {
            showToast('Please select a payment method', 'error');
            return;
        }

        const btn = document.getElementById('placeOrderBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Processing...';

        try {
            if (selectedPaymentMethod === 'RAZORPAY') {
                const razorpayResponse = await fetch('/create-razorpay-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        addressId: selectedAddressId,
                        paymentMethod: selectedPaymentMethod
                    })
                });
                const razorpayData = await razorpayResponse.json();
                if (!razorpayData.success) {
                    showToast(razorpayData.message || 'Failed to create Razorpay order', 'error');
                    btn.disabled = false;
                    btn.innerHTML = 'Place Order';
                    if (razorpayData.redirectUrl) {
                        window.location.href = razorpayData.redirectUrl;
                    }
                    return;
                }
                const options = {
                    key: razorpayData.key_id,
                    amount: razorpayData.order.amount,
                    currency: razorpayData.order.currency,
                    name: 'REVIVO',
                    description: 'Purchase from REVIVO',
                    order_id: razorpayData.order.id,
                    handler: async function (response) {
                        const orderResponse = await fetch('/create-order', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                addressId: selectedAddressId,
                                paymentMethod: selectedPaymentMethod,
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature
                            })
                        });
                        const orderData = await orderResponse.json();
                        if (orderData.success) {
                            window.location.href = orderData.redirectUrl;
                        } else {
                            showToast(orderData.message || 'Order creation failed after payment', 'error');
                            if (orderData.redirectUrl) {
                                window.location.href = orderData.redirectUrl;
                            }
                        }
                    },
                    prefill: {
                        name: razorpayData.user.name,
                        email: razorpayData.user.email,
                        contact: razorpayData.user.phone
                    },
                    theme: {
                        color: '#2C2C2C'
                    }
                };
                const razorpayInstance = new Razorpay(options);
                razorpayInstance.open();
                btn.disabled = false;
                btn.innerHTML = 'Place Order';
                razorpayInstance.on('payment.failed', function (response) {
                    showToast('Payment failed: ' + response.error.description, 'error');
                });
            } else {
                const response = await fetch('/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        addressId: selectedAddressId,
                        paymentMethod: selectedPaymentMethod
                    })
                });
                const data = await response.json();
                if (data.success) {
                    window.location.href = data.redirectUrl;
                } else {
                    showToast(data.message || 'Failed to place order', 'error');
                    if (data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    }
                }
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('An error occurred while placing the order', 'error');
            btn.disabled = false;
            btn.innerHTML = 'Place Order';
            window.location.href = '/order-failure?errorMessage=An%20unexpected%20error%20occurred%20while%20processing%20your%20order.%20Please%20try%20again.';
        }
    }

    function openAddressModal(addressId = null) {
        const modal = document.getElementById('addressModal');
        const form = document.getElementById('addressForm');
        const title = document.getElementById('modalTitle');
        
        if (addressId) {
            title.textContent = 'Edit Address';
            document.getElementById('addressId').value = addressId;
        } else {
            title.textContent = 'Add New Address';
            form.reset();
            document.getElementById('addressId').value = '';
        }
        modal.classList.remove('hidden');
    }

    function closeAddressModal() {
        document.getElementById('addressModal').classList.add('hidden');
    }

    async function handleAddressFormSubmit(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const addressId = document.getElementById('addressId').value;

        if(!/^\d{10}$/.test(formData.get('phone'))) {
            return showToast('Invalid phone number format', 'error');
        }
        if(!/^\d{6}$/.test(formData.get('pincode'))) {
            return showToast('Invalid pincode format', 'error');
        }
        
        try {
            const response = await fetch(addressId ? `/addresses/${addressId}` : '/addresses', {
                method: addressId ? 'PATCH' : 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(Object.fromEntries(formData))
            });
            
            const data = await response.json();
            
            if (response.ok) {
                showToast('Address saved successfully!', 'success');
                closeAddressModal();
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(data.message || 'Failed to save address', 'error');
            }
        } catch (error) {
            console.error('Error:', error);
            showToast('An error occurred while saving the address', 'error');
        }
    }

    function showToast(message, type = 'success') {
        const toast = document.createElement('div');
        toast.className = `fixed top-16 sm:top-20 right-4 ${type === 'success' ? 'bg-[#2C2C2C]' : 'bg-red-500'} text-white px-4 sm:px-6 py-2 sm:py-3 rounded-lg shadow-xl flex items-center max-w-[85%] sm:max-w-[90%] z-50`;
        toast.innerHTML = `
            <span class="mr-2 flex-shrink-0">${type === 'success' ? '✓' : '⚠'}</span>
            <span class="font-montserrat text-xs sm:text-sm">${message}</span>
        `;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    document.getElementById('addressForm')?.addEventListener('submit', handleAddressFormSubmit);

    document.addEventListener('DOMContentLoaded', () => {
        console.log('isCODAvailable:', <%= isCODAvailable %>);
        console.log('walletBalance:', <%= walletBalance %>);
        console.log('total:', <%= total %>);

        // Select a default payment method
        let defaultMethod = null;
        if (<%= isCODAvailable %>) {
            defaultMethod = document.querySelector('[data-method="COD"]');
            if (defaultMethod) {
                defaultMethod.classList.add('selected');
                selectedPaymentMethod = 'COD';
            }
        } else if (<%= walletBalance %> >= <%= total %>) {
            defaultMethod = document.querySelector('[data-method="WALLET"]');
            if (defaultMethod) {
                defaultMethod.classList.add('selected');
                selectedPaymentMethod = 'WALLET';
            }
        } else {
            defaultMethod = document.querySelector('[data-method="RAZORPAY"]');
            if (defaultMethod) {
                defaultMethod.classList.add('selected');
                selectedPaymentMethod = 'RAZORPAY';
            }
        }

        if (!defaultMethod) {
            console.warn('No valid payment method found for default selection');
        } else {
            console.log('Default payment method selected:', selectedPaymentMethod);
        }

        const defaultAddress = document.querySelector('.address-card [data-is-default="true"]');
        if (defaultAddress) {
            selectAddress(defaultAddress.closest('.address-card'));
        } else {
            const firstAddress = document.querySelector('.address-card');
            if (firstAddress) {
                selectAddress(firstAddress);
            }
        }
    });
</script>


</body>
</html>
