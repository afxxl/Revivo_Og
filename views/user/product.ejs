<!doctype html>
<html lang="en">
  <head>
    <title><%= product.productName %> | REVIVO</title>
    <link href="/css/styles.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Henny+Penny&family=Playfair+Display:wght@400;500;600&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
      .product-gallery-thumbnail {
        transition: all 0.3s ease;
      }
      .product-gallery-thumbnail:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
        border-color: #f8c78d;
      }
      .product-gallery-thumbnail.active {
        border-color: #f8c78d;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
      }
      .section-heading {
        font-family: 'Playfair Display', serif;
        font-weight: 500;
        letter-spacing: 0.05em;
        position: relative;
        display: inline-block;
      }
      .section-heading::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 60px;
        height: 2px;
        background-color: #f8c78d;
        transition: width 0.3s ease;
      }
      .section-heading:hover::after {
        width: 100%;
      }
      .font-playfair {
        font-family: 'Playfair Display', serif;
      }
      .font-montserrat {
        font-family: 'Montserrat', sans-serif;
      }
      .font-henny {
        font-family: 'Henny Penny', cursive;
      }
      .trust-badge {
        background-color: #f8f7f5;
        border-radius: 8px;
        padding: 12px 16px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .trust-badge:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.05);
      }
      
      /* Image zoom container */
      .img-zoom-container {
        position: relative;
        overflow: hidden;
        background-color: white;
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      }
      
      .img-zoom-container img {
        transition: transform 0.5s ease;
        width: 100%;
        height: auto;
        object-fit: contain;
        max-height: 500px;
      }
      
      /* Custom quantity input styles */
      .custom-number-input button {
        background-color: #f8f7f5;
        border: 1px solid #e0dcd4;
        color: #2C2C2C;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        transition: all 0.2s ease;
      }
      
      .custom-number-input button:hover {
        background-color: #e0dcd4;
      }
      
      .custom-number-input input {
        border: 1px solid #e0dcd4;
        width: 40px;
        height: 32px;
        text-align: center;
        font-size: 14px;
        -moz-appearance: textfield;
      }
      
      /* Remove arrows from number input */
      .custom-number-input input::-webkit-outer-spin-button,
      .custom-number-input input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }
      
      /* Add to cart button effect */
      .add-to-cart-btn {
        background-color: #2C2C2C;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
      }
      
      .add-to-cart-btn::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: -100%;
        background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
        transition: all 0.6s ease;
      }
      
      .add-to-cart-btn:hover {
        background-color: #1a1a1a;
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);
      }
      
      .add-to-cart-btn:hover::after {
        left: 100%;
      }

      .wishlist-btn {
        position: relative;
        overflow: hidden;
      }
      .wishlist-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }
      .wishlist-btn[disabled] {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .wishlist-icon.active {
        fill: #f8c78d;
        stroke: #f8c78d;
      }
      .wishlist-btn.active {
        border-color: #f8c78d;
      }
    </style>
  </head>

  <body class="bg-[#f8f7f5]">
    <%- include('../partials/user/header.ejs') %>

    <section class="py-12">
      <div class="container mx-auto px-4 max-w-7xl">
        <div class="mb-6 font-montserrat text-sm text-[#2C2C2C]/70">
          <a href="/" class="hover:text-[#f8c78d]">Home</a> / 
          <a href="/shop" class="hover:text-[#f8c78d]">Shop</a> / 
          <span class="text-[#2C2C2C]"><%= product.productName %></span>
        </div>

        <div class="flex flex-col lg:flex-row gap-12">
          <div class="lg:w-1/2">
            <div class="img-zoom-container p-4 mb-4" id="imageZoomContainer">
              <img 
                id="mainProductImage"
                src="<%= product.productImage[0] %>" 
                alt="<%= product.productName %>"
                class="w-full h-auto object-contain max-h-[500px]"
                onerror="this.src='/Images/placeholder.jpg'"
              >
            </div>

            <div class="flex gap-3 overflow-x-auto py-2">
              <% product.productImage.forEach((image, index) => { %>
                <div 
                  class="product-gallery-thumbnail flex-shrink-0 w-20 h-20 bg-white border-2 border-[#e0dcd4] rounded-md p-1 cursor-pointer <%= index === 0 ? 'active' : '' %>"
                  onclick="changeMainImage('<%= image %>', this)"
                >
                  <img 
                    src="<%= image %>" 
                    alt="Thumbnail <%= index + 1 %>"
                    class="w-full h-full object-contain"
                    onerror="this.src='/Images/placeholder.jpg'"
                  >
                </div>
              <% }); %>
            </div>

            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="trust-badge flex items-center gap-3">
                <div class="text-[#f8c78d] text-xl">
                  <i class="fas fa-shield-alt"></i>
                </div>
                <div>
                  <p class="text-sm font-montserrat font-medium">100% Authentic</p>
                  <p class="text-xs text-[#2C2C2C]/70">Quality Guaranteed</p>
                </div>
              </div>
              <div class="trust-badge flex items-center gap-3">
                <div class="text-[#f8c78d] text-xl">
                  <i class="fas fa-truck"></i>
                </div>
                <div>
                  <p class="text-sm font-montserrat font-medium">Free Shipping</p>
                  <p class="text-xs text-[#2C2C2C]/70">On orders over $50</p>
                </div>
              </div>
              <div class="trust-badge flex items-center gap-3">
                <div class="text-[#f8c78d] text-xl">
                  <i class="fas fa-undo"></i>
                </div>
                <div>
                  <p class="text-sm font-montserrat font-medium">Easy Returns</p>
                  <p class="text-xs text-[#2C2C2C]/70">14-Day Policy</p>
                </div>
              </div>
              <div class="trust-badge flex items-center gap-3">
                <div class="text-[#f8c78d] text-xl">
                  <i class="fas fa-money-bill-wave"></i>
                </div>
                <div>
                  <p class="text-sm font-montserrat font-medium">Cash on Delivery</p>
                  <p class="text-xs text-[#2C2C2C]/70">Pay when received</p>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:w-1/2">
            <div class="bg-white p-8 rounded-lg shadow-sm">
              <% if (!product.isListed || !product.brand.isActive || !product.category.isListed || product.stock <= 0 || product.status !== 'Available') { %>
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6" role="alert">
                  <p class="font-bold">Product Unavailable</p>
                  <p>
                    <% if (!product.isListed) { %>
                      This product is no longer available.
                    <% } else if (!product.brand.isActive) { %>
                      This product's brand is not available.
                    <% } else if (!product.category.isListed) { %>
                      This product's category is not available.
                    <% } else if (product.stock <= 0 || product.status !== 'Available') { %>
                      This product is out of stock.
                    <% } %>
                  </p>
                </div>
              <% } %>

              <div class="mb-4">
                <span class="text-xs text-[#2C2C2C]/60 font-montserrat uppercase tracking-wider">
                  <%= product.category?.name || 'Vintage' %> / <%= product.brand?.brandName || 'Generic' %>
                </span>
              </div>

              <h1 class="text-3xl font-playfair mb-4 text-[#2C2C2C]"><%= product.productName %></h1>

              <div class="flex items-center mb-4">
                <div class="flex text-[#f8c78d] mr-2">
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star"></i>
                  <i class="fas fa-star-half-alt"></i>
                </div>
                <span class="text-sm text-[#2C2C2C]/70 font-montserrat">4.8 (124 Reviews)</span>
              </div>

              <div class="mb-6">
                <% 
                  const productOffer = product.productOffer || 0;
                  const categoryOffer = product.category && product.category.categoryOffer ? product.category.categoryOffer : 0;
                  const bestOfferPercentage = Math.max(productOffer, categoryOffer);
                  const originalPrice = product.salesPrice;
                  let finalPrice = originalPrice;
                  
                  if (bestOfferPercentage > 0) {
                    const offerAmount = originalPrice * (bestOfferPercentage / 100);
                    finalPrice = originalPrice - offerAmount;
                  }
                %>
                
                <% if (bestOfferPercentage > 0) { %>
                  <div class="bg-green-100 text-green-700 px-3 py-1.5 rounded-md inline-block text-xs font-montserrat font-medium mb-2">
                    <% if (productOffer > categoryOffer) { %>
                      Product Offer: <%= productOffer %>% off
                    <% } else if (categoryOffer > 0) { %>
                      Category Offer: <%= categoryOffer %>% off
                    <% } %>
                  </div>
                  <div>
                    <p class="text-2xl font-montserrat font-medium text-[#2C2C2C]">
                      $<%= finalPrice.toFixed(2) %>
                      <span class="ml-2 text-xs font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded">Save $<%= (originalPrice - finalPrice).toFixed(2) %></span>
                    </p>
                    <p class="text-[#2C2C2C]/60 text-sm font-montserrat line-through">
                      $<%= originalPrice.toFixed(2) %>
                    </p>
                  </div>
                <% } else { %>
                  <p class="text-2xl font-montserrat font-medium text-[#2C2C2C]">$<%= originalPrice.toFixed(2) %></p>
                <% } %>
              </div>

              <% if (product.stock > 0 && product.stock < 10) { %>
                <div class="mb-4 bg-amber-50 p-3 rounded-lg border-l-4 border-amber-500">
                  <p class="text-sm font-montserrat text-amber-800 flex items-center">
                    <i class="fas fa-exclamation-triangle text-amber-500 mr-2"></i>
                    Only <%= product.stock %> left in stock - order soon!
                  </p>
                </div>
              <% } %>

              <div class="mb-6 grid grid-cols-2 gap-4">
                <div class="bg-[#f8f7f5] p-3 rounded-lg">
                  <p class="text-xs text-[#2C2C2C]/60 font-montserrat mb-1">Condition</p>
                  <p class="font-montserrat font-medium"><%= product.condition %></p>
                </div>
                <div class="bg-[#f8f7f5] p-3 rounded-lg">
                  <p class="text-xs text-[#2C2C2C]/60 font-montserrat mb-1">Size</p>
                  <p class="font-montserrat font-medium"><%= product.size %></p>
                </div>
              </div>

              <div class="mb-6">
                <p class="text-sm font-montserrat <%= product.stock > 0 ? 'text-green-600' : 'text-red-600' %>">
                  <i class="<%= product.stock > 0 ? 'fas fa-check-circle' : 'fas fa-times-circle' %> mr-1"></i>
                  <%= product.stock > 0 ? 'In Stock' : 'Out of Stock' %>
                </p>
              </div>

              <div class="mb-6">
                <label class="text-xs text-[#2C2C2C]/60 font-montserrat mb-2 block">Quantity</label>
                <div class="custom-number-input flex items-center w-32">
                  <button class="rounded-l-md" onclick="decreaseQuantity()">-</button>
                  <input type="number" id="quantity" value="1" min="1" max="<%= Math.min(product.stock, 10) %>" 
                         class="font-montserrat">
                  <button class="rounded-r-md" onclick="increaseQuantity()">+</button>
                </div>
                <p class="text-xs text-[#2C2C2C]/60 font-montserrat mt-2">Maximum 10 per order</p>
              </div>

              <div class="flex gap-3 mb-6">
                <button 
                  onclick="addToCart('<%= product._id %>')"
                  class="flex-1 py-3 text-white rounded-md transition-all duration-300 font-montserrat add-to-cart-btn"
                  <%= (!product.isListed || !product.brand.isActive || !product.category.isListed || product.stock <= 0 || product.status !== 'Available') ? 'disabled' : '' %>
                >
                  <%= (!product.isListed || !product.brand.isActive || !product.category.isListed || product.stock <= 0 || product.status !== 'Available') ? 'Unavailable' : 'Add to Cart' %>
                </button>
                
                <button 
                  id="wishlist-btn"
                  type="button"
                  class="wishlist-btn w-14 bg-white border border-[#e0dcd4] text-[#2C2C2C] rounded-md flex items-center justify-center transition-all duration-300 hover:bg-[#f8f7f5]"
                  <%= (!product.isListed || !product.brand.isActive || !product.category.isListed || product.stock <= 0 || product.status !== 'Available') ? 'disabled' : '' %>
                  data-in-wishlist="false"
                  data-product-id="<%= product._id %>"
                  data-product-name="<%= product.productName %>"
                >
                  <svg class="w-5 h-5 wishlist-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                  </svg>
                </button>
              </div>

              <div class="mb-8 p-4 bg-[#f8f7f5] rounded-lg border border-[#e0dcd4]">
                <div class="flex items-center justify-center gap-2">
                  <i class="fas fa-lock text-[#f8c78d]"></i>
                  <p class="text-sm font-montserrat">Secure Checkout</p>
                </div>
              </div>

              <div class="mb-8">
                <h3 class="text-lg font-playfair mb-4 section-heading">Description</h3>
                <p class="text-[#2C2C2C]/80 font-montserrat leading-relaxed"><%= product.description %></p>
              </div>

              <div class="mb-8">
                <h3 class="text-lg font-playfair mb-4 section-heading">Product Details</h3>
                <ul class="text-[#2C2C2C]/80 font-montserrat leading-relaxed space-y-3">
                  <li class="flex items-start">
                    <i class="fas fa-check text-[#f8c78d] mr-2 mt-1 text-xs"></i>
                    <span>Authentic vintage item carefully curated</span>
                  </li>
                  <li class="flex items-start">
                    <i class="fas fa-check text-[#f8c78d] mr-2 mt-1 text-xs"></i>
                    <span>Professional cleaning and inspection</span>
                  </li>
                  <li class="flex items-start">
                    <i class="fas fa-check text-[#f8c78d] mr-2 mt-1 text-xs"></i>
                    <span>Eco-friendly packaging</span>
                  </li>
                </ul>
              </div>

              <div class="mb-6">
                <h3 class="text-lg font-playfair mb-4 section-heading">Shipping & Returns</h3>
                <div class="space-y-4">
                  <div class="flex items-start gap-3 bg-[#f8f7f5] p-3 rounded-lg">
                    <div class="text-[#f8c78d] mt-1">
                      <i class="fas fa-shipping-fast"></i>
                    </div>
                    <div>
                      <p class="text-sm font-montserrat font-medium">Fast Delivery</p>
                      <p class="text-xs text-[#2C2C2C]/70">Typically ships within 1-2 business days</p>
                    </div>
                  </div>
                  <div class="flex items-start gap-3 bg-[#f8f7f5] p-3 rounded-lg">
                    <div class="text-[#f8c78d] mt-1">
                      <i class="fas fa-undo"></i>
                    </div>
                    <div>
                      <p class="text-sm font-montserrat font-medium">Easy Returns</p>
                      <p class="text-xs text-[#2C2C2C]/70">14-day return policy for unused items</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%- include('../partials/user/footer.ejs') %>

    <script>
      // Image zoom functionality
      document.addEventListener('DOMContentLoaded', function() {
        const container = document.getElementById('imageZoomContainer');
        const img = document.getElementById('mainProductImage');
        
        if (container && img) {
          container.addEventListener('mousemove', function(e) {
            const { left, top, width, height } = container.getBoundingClientRect();
            const x = (e.clientX - left) / width;
            const y = (e.clientY - top) / height;
            
            img.style.transformOrigin = `${x * 100}% ${y * 100}%`;
            img.style.transform = 'scale(1.5)';
          });
          
          container.addEventListener('mouseleave', function() {
            img.style.transform = 'scale(1)';
          });
        }
      });

      function changeMainImage(src, element) {
        document.getElementById('mainProductImage').src = src;
        
        document.querySelectorAll('.product-gallery-thumbnail').forEach(thumb => {
          thumb.classList.remove('active');
        });
        
        element.classList.add('active');
      }

      function increaseQuantity() {
        const quantityInput = document.getElementById('quantity');
        const max = Math.min(parseInt(quantityInput.max), 10);
        let value = parseInt(quantityInput.value);
        if (value < max) {
          quantityInput.value = value + 1;
        } else if (value >= 10) {
          showToast('Maximum 10 items per product allowed', 'warning');
        }
      }

      function decreaseQuantity() {
        const quantityInput = document.getElementById('quantity');
        let value = parseInt(quantityInput.value);
        if (value > 1) {
          quantityInput.value = value - 1;
        }
      }

      async function addToCart(productId) {
        const quantity = document.getElementById('quantity').value;
        
        try {
          const response = await fetch('/add-to-cart', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ 
              productId,
              quantity: parseInt(quantity)
            }),
          });

          const data = await response.json();

          if (data.success) {
            showToast('Added to cart successfully!', 'success');
            
            // Update cart count
            if (data.cartCount) {
              const cartCountElements = document.querySelectorAll('#cart-count');
              cartCountElements.forEach(el => {
                el.textContent = data.cartCount;
                el.classList.remove('hidden');
              });
            }
            
            // If item was in wishlist and got removed, update wishlist UI
            if (data.wishlistCount !== undefined) {
              // Update wishlist count
              const wishlistCountElements = document.querySelectorAll('#wishlist-count');
              wishlistCountElements.forEach(el => {
                el.textContent = data.wishlistCount;
              });
              
              // Update wishlist button to show item is not in wishlist
              const wishlistBtn = document.getElementById('wishlist-btn');
              const wishlistIcon = document.querySelector('.wishlist-icon');
              
              if (wishlistBtn && wishlistIcon) {
                wishlistIcon.classList.remove('active');
                wishlistBtn.classList.remove('active');
                wishlistBtn.setAttribute('data-in-wishlist', 'false');
              }
            }
          } else {
            throw new Error(data.message || 'Failed to add to cart');
          }
        } catch (error) {
          console.error('Error adding to cart:', error);
          showToast(error.message || 'Failed to add to cart', 'error');
        }
      }

      function showToast(message, type = 'success') {
        const toast = document.createElement('div');
        toast.className = `fixed bottom-4 right-4 ${
          type === 'success' ? 'bg-[#2C2C2C]' : 
          type === 'warning' ? 'bg-yellow-500' : 
          type === 'info' ? 'bg-blue-500' : 'bg-red-500'
        } text-white px-6 py-3 rounded-lg shadow-xl transform translate-y-0 opacity-100 transition-all duration-300 z-50 flex items-center`;
        
        const icon = document.createElement('span');
        icon.className = 'mr-2';
        icon.innerHTML = 
          type === 'success' ? '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>' :
          type === 'warning' ? '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>' :
          type === 'info' ? '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>' :
          '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
        
        const text = document.createElement('span');
        text.textContent = message;
        text.className = 'font-montserrat';
        
        toast.appendChild(icon);
        toast.appendChild(text);
        document.body.appendChild(toast);

        setTimeout(() => {
          toast.classList.add('translate-y-full', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }

      // Check if item is in wishlist when page loads
      document.addEventListener('DOMContentLoaded', function() {
        // Debounce function to prevent multiple rapid clicks
        function debounce(func, wait) {
          let timeout;
          return function(...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => {
              func.apply(this, args);
            }, wait);
          };
        }
        
        // Initialize the wishlist button
        initializeWishlistButton();
        
        // Create debounced version of toggleWishlist
        const debouncedToggleWishlist = debounce((productId, productName) => {
          toggleWishlist(productId, productName);
        }, 300);
        
        // Track if a wishlist operation is in progress
        window.wishlistOperationInProgress = false;
        
        // Add click event listener to wishlist button
        document.body.addEventListener('click', function(event) {
          // Check if click target is the wishlist button or any of its children
          const wishlistBtn = document.getElementById('wishlist-btn');
          if (!wishlistBtn) return;
          
          // Find if the clicked element is wishlist button or its child
          let targetElement = event.target;
          let isWishlistClick = false;
          
          while (targetElement != null) {
            if (targetElement === wishlistBtn) {
              isWishlistClick = true;
              break;
            }
            targetElement = targetElement.parentElement;
          }
          
          if (isWishlistClick) {
            event.preventDefault();
            
            // Prevent multiple clicks while operation is in progress
            if (window.wishlistOperationInProgress) {
              return;
            }
            
            const productId = wishlistBtn.getAttribute('data-product-id');
            const productName = wishlistBtn.getAttribute('data-product-name');
            
            if (productId && productName) {
              debouncedToggleWishlist(productId, productName);
            }
          }
        });
      });
      
      // Function to initialize wishlist button
      function initializeWishlistButton() {
        const wishlistBtn = document.getElementById('wishlist-btn');
        if (!wishlistBtn) {
          // Button might not be loaded yet, try again in a moment
          setTimeout(initializeWishlistButton, 500);
          return;
        }
        
        // Initialize wishlist status as false by default
        wishlistBtn.setAttribute('data-in-wishlist', 'false');
        
        // Ensure onclick is properly set - this is critical for new products
        const productId = '<%= product._id %>';
        const productName = '<%= product.productName %>';
        
        // Check if the onclick attribute is set properly
        const onclickAttr = wishlistBtn.getAttribute('onclick');
        if (!onclickAttr || !onclickAttr.includes('toggleWishlist')) {
          wishlistBtn.setAttribute('onclick', `toggleWishlist('${productId}', '${productName}')`);
        }
        
        // If button is disabled but product is available, enable it
        const productIsListed = '<%= product.isListed %>' === 'true';
        const brandIsActive = '<%= product.brand.isActive %>' === 'true';
        const categoryIsListed = '<%= product.category.isListed %>' === 'true';
        const hasStock = parseInt('<%= product.stock %>') > 0;
        const isAvailable = '<%= product.status %>' === 'Available';
        
        const isUnavailable = !productIsListed || !brandIsActive || !categoryIsListed || !hasStock || !isAvailable;
        
        if (wishlistBtn.disabled && !isUnavailable) {
          wishlistBtn.disabled = false;
        }
        
        checkInitialWishlistStatus();
      }
      
      // Function to check initial wishlist status
      async function checkInitialWishlistStatus() {
        try {
          const productId = '<%= product._id %>';
          
          if (!productId || productId === 'undefined') {
            return;
          }
          
          const response = await fetch(`/check-wishlist-status/${productId}`);
          
          if (!response.ok) {
            throw new Error(`Failed to check wishlist status: ${response.status}`);
          }
          
          const responseText = await response.text();
          
          let data;
          try {
            data = JSON.parse(responseText);
          } catch (error) {
            return;
          }
          
          const wishlistBtn = document.getElementById('wishlist-btn');
          if (!wishlistBtn) {
            return;
          }
          
          if (data.inWishlist) {
            const wishlistIcon = document.querySelector('.wishlist-icon');
            
            if (wishlistIcon) {
              wishlistIcon.classList.add('active');
              wishlistBtn.classList.add('active');
              wishlistBtn.setAttribute('data-in-wishlist', 'true');
            }
          } else {
            wishlistBtn.setAttribute('data-in-wishlist', 'false');
          }
        } catch (error) {
          console.error('Error checking initial wishlist status:', error);
        }
      }
      
      // AJAX function to add or remove from wishlist
      async function toggleWishlist(productId, productName) {
        // If an operation is already in progress, don't start another one
        if (window.wishlistOperationInProgress) {
          return;
        }
        
        // Set the flag to indicate an operation is in progress
        window.wishlistOperationInProgress = true;
        
        if (!productId) {
          showToast('Missing product ID', 'error');
          window.wishlistOperationInProgress = false;
          return;
        }
        
        // Format check for productId
        if (!/^[0-9a-fA-F]{24}$/.test(productId)) {
          showToast('Invalid product ID format', 'error');
          window.wishlistOperationInProgress = false;
          return;
        }
        
        const wishlistBtn = document.getElementById('wishlist-btn');
        if (!wishlistBtn) {
          showToast('Error: UI element not found', 'error');
          window.wishlistOperationInProgress = false;
          return;
        }
        
        const isInWishlist = wishlistBtn.getAttribute('data-in-wishlist') === 'true';
        const action = isInWishlist ? 'remove from' : 'add to';
        
        // Disable button while action is in progress
        wishlistBtn.disabled = true;
        
        try {
          // Show loading state
          const wishlistIcon = document.querySelector('.wishlist-icon');
          if (wishlistIcon) {
            wishlistIcon.innerHTML = `<div class="spinner-border w-4 h-4"></div>`;
          }
          
          const endpoint = isInWishlist ? '/remove-from-wishlist' : '/add-to-wishlist';
          
          let response;
          try {
            const requestBody = JSON.stringify({ productId });
            
            response = await fetch(endpoint, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: requestBody,
              credentials: 'include'
            });
          } catch (networkError) {
            throw new Error(`Network error: ${networkError.message}`);
          }
          
          if (response.status === 401) {
            // User is not logged in
            showToast('Please login to add items to your wishlist', 'warning');
            // Redirect to login page after a short delay
            setTimeout(() => {
              window.location.href = '/login';
            }, 2000);
            return;
          }
          
          let data;
          try {
            const responseText = await response.text();
            
            try {
              data = JSON.parse(responseText);
            } catch (jsonError) {
              throw new Error('Server response was not valid JSON: ' + responseText.substring(0, 100));
            }
          } catch (textError) {
            throw new Error('Failed to read server response');
          }
          
          if (response.status === 400) {
            // Product validation error
            showToast(data.message || 'Product is unavailable', 'warning');
            return;
          }
          
          if (response.status === 404) {
            // Product not found
            showToast(data.message || 'Product not found', 'error');
            return;
          }
          
          if (data.success) {
            // Update UI based on action
            if (isInWishlist) {
              // Item was removed from wishlist
              wishlistIcon.classList.remove('active');
              wishlistBtn.classList.remove('active');
              wishlistBtn.setAttribute('data-in-wishlist', 'false');
              showToast(`Removed ${productName} from wishlist`, 'success');
            } else {
              // Item was added to wishlist
              wishlistIcon.classList.add('active');
              wishlistBtn.classList.add('active');
              wishlistBtn.setAttribute('data-in-wishlist', 'true');
              showToast(`Added ${productName} to wishlist`, 'success');
            }
            
            // Update wishlist count in header
            if (data.wishlistCount !== undefined) {
              document.querySelectorAll('#wishlist-count').forEach(el => {
                el.textContent = data.wishlistCount;
              });
            }
          } else {
            // Non-successful response but not caught by status code checks
            throw new Error(data.message || `Failed to ${action} wishlist`);
          }
        } catch (error) {
          console.error(`Error updating wishlist:`, error);
          showToast(error.message || `Error updating wishlist`, 'error');
        } finally {
          // Ensure icon is reset if still showing spinner
          const wishlistIcon = document.querySelector('.wishlist-icon');
          if (wishlistIcon && wishlistIcon.innerHTML.includes('spinner-border')) {
            wishlistIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>`;
          }
          
          // Re-enable button
          wishlistBtn.disabled = false;
          
          // Reset the operation in progress flag
          window.wishlistOperationInProgress = false;
        }
      }
    </script>
  </body>
</html>
