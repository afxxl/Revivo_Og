    .trend-indicator:hover {
        background-color: rgba(0,0,0,0.05);
    }

    .trend-up {
        color: #059669;
    }

    .trend-down {
        color: #dc2626;
    }

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .action-button {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1.25rem;
        border-radius: 0.75rem;
