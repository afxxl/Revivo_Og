<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --mobile: 480px;
            --tablet: 768px;
            --laptop: 1024px;
            --desktop: 1280px;
        }
        
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #F3F4F6;
        }
        .brand-heading {
            font-family: 'Playfair Display', serif;
        }
        
        .error-container {
            padding: 1rem;
            max-width: 100%;
        }
        
        @media (min-width: 480px) {
            .error-container {
                padding: 1.5rem;
            }
        }
        
        @media (min-width: 768px) {
            .error-container {
                padding: 2rem;
            }
        }
        
        .error-icon {
            width: 4rem;
            height: 4rem;
        }
        
        @media (min-width: 480px) {
            .error-icon {
                width: 5rem;
                height: 5rem;
            }
        }
        
        @media (min-width: 768px) {
            .error-icon {
                width: 6rem;
                height: 6rem;
            }
        }
        
        .error-title {
            font-size: 1.75rem;
            margin-bottom: 0.5rem;
        }
        
        @media (min-width: 480px) {
            .error-title {
                font-size: 2rem;
                margin-bottom: 0.75rem;
            }
        }
        
        @media (min-width: 768px) {
            .error-title {
                font-size: 2.25rem;
                margin-bottom: 1rem;
            }
        }
        
        .error-message {
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
        }
        
        @media (min-width: 480px) {
            .error-message {
                font-size: 1rem;
                margin-bottom: 1.75rem;
            }
        }
        
        @media (min-width: 768px) {
            .error-message {
                font-size: 1.125rem;
                margin-bottom: 2rem;
            }
        }
        
        .action-button {
            width: 100%;
            padding: 0.75rem 1.5rem;
            font-size: 0.9rem;
            border-radius: 0.375rem;
        }
        
        @media (min-width: 768px) {
            .action-button {
                width: auto;
                padding: 0.75rem 2rem;
                font-size: 1rem;
            }
        }
        
        .secondary-action {
            font-size: 0.9rem;
            margin-top: 1rem;
        }
        
        @media (min-width: 480px) {
            .secondary-action {
                font-size: 0.95rem;
                margin-top: 1.25rem;
            }
        }
        
        .error-footer {
            margin-top: 2rem;
            font-size: 0.75rem;
        }
        
        @media (min-width: 480px) {
            .error-footer {
                margin-top: 2.5rem;
                font-size: 0.8rem;
            }
        }
        
        @media (min-width: 768px) {
            .error-footer {
                margin-top: 3rem;
                font-size: 0.875rem;
            }
        }
    </style>
</head>
<body>

<div class="min-h-screen flex items-center justify-center p-4 error-container">
    <div class="max-w-md w-full text-center">
        <div class="mb-6 sm:mb-8 inline-block">
            <svg class="error-icon text-[#6C7559] mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                </path>
            </svg>
        </div>

        <h1 class="brand-heading error-title font-bold text-[#6C7559]">Oops!</h1>
        <p class="text-gray-600 error-message">Something went wrong on our end.</p>

        <div class="space-y-4">
            <button onclick="window.location.href='/admin/dashboard'" 
                    class="action-button bg-[#6C7559] text-white rounded-lg hover:bg-[#5a6349] transition-colors duration-200">
                Return to Dashboard
            </button>
            
            <div class="flex justify-center secondary-action">
                <button onclick="window.location.href='/admin/login'" 
                        class="text-[#6C7559] hover:text-[#5a6349] font-medium">
                    Return to Login
                </button>
            </div>
        </div>

        <div class="error-footer text-gray-500">
            <p>If this problem persists, please contact the system administrator.</p>
            <p class="mt-2">Error Code: <%= Date.now().toString(36) %></p>
        </div>
    </div>
</div>

<div class="fixed top-0 left-0 w-full h-1 bg-gradient-to-r from-[#6C7559] to-[#A4B494]"></div>
<div class="fixed bottom-0 left-0 w-full h-1 bg-gradient-to-r from-[#A4B494] to-[#6C7559]"></div>

</body>
</html>

