<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Revivo</title>
    <script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --mobile: 480px;
            --tablet: 768px;
            --laptop: 1024px;
            --desktop: 1280px;
        }
        
        body {
            background-image: url("/Images/images/OLD_PAPER_TEXTURE.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        .input-group:focus-within {
            border-color: #6C7559;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            animation: fadeIn 0.3s ease-out;
        }

        .illustration-bg {
            background-color: #FDF8F3;
            background-image: radial-gradient(#6C7559 0.5px, transparent 0.5px);
            background-size: 10px 10px;
        }

        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }

        .transform:hover {
            animation: float 2s ease-in-out infinite;
        }
        
        /* Responsive styles */
        .login-container {
            padding: 1rem;
        }
        
        @media (min-width: 480px) {
            .login-container {
                padding: 1.5rem;
            }
        }
        
        .login-card {
            width: 100%;
            max-width: 100%;
            flex-direction: column;
        }
        
        @media (min-width: 768px) {
            .login-card {
                flex-direction: row;
                max-width: 64rem;
            }
        }
        
        .login-form-container {
            width: 100%;
            padding: 1.25rem;
        }
        
        @media (min-width: 480px) {
            .login-form-container {
                padding: 1.5rem;
            }
        }
        
        @media (min-width: 768px) {
            .login-form-container {
                width: 50%;
                padding: 2rem;
            }
        }
        
        .login-brand {
            font-size: 1.75rem;
            margin-bottom: 1rem;
        }
        
        @media (min-width: 480px) {
            .login-brand {
                font-size: 2rem;
                margin-bottom: 1.5rem;
            }
        }
        
        .login-title {
            font-size: 1.5rem;
        }
        
        @media (min-width: 480px) {
            .login-title {
                font-size: 1.75rem;
            }
        }
        
        @media (min-width: 768px) {
            .login-title {
                font-size: 2rem;
            }
        }
        
        .login-subtitle {
            font-size: 0.875rem;
        }
        
        @media (min-width: 480px) {
            .login-subtitle {
                font-size: 1rem;
            }
        }
        
        .login-form-spacing {
            margin-top: 1.5rem;
        }
        
        @media (min-width: 480px) {
            .login-form-spacing {
                margin-top: 2rem;
            }
        }
        
        .login-input {
            font-size: 0.9rem;
            padding: 0.75rem 0.5rem;
        }
        
        @media (min-width: 480px) {
            .login-input {
                font-size: 1rem;
                padding: 0.75rem 0.75rem;
            }
        }
        
        .login-button {
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            margin-top: 1.5rem;
        }
        
        @media (min-width: 480px) {
            .login-button {
                padding: 0.75rem 1.5rem;
                font-size: 1rem;
                margin-top: 2rem;
            }
        }
        
        .illustration-container {
            display: none;
        }
        
        @media (min-width: 768px) {
            .illustration-container {
                display: block;
                width: 50%;
            }
        }
    </style>
</head>
<body>
    <div class="min-h-screen flex items-center justify-center login-container">
        <div class="w-full max-w-4xl flex rounded-lg shadow-lg overflow-hidden login-card">
            <div class="w-full md:w-1/2 p-4 sm:p-6 md:p-8 backdrop-blur-sm bg-white/30 login-form-container">
                <div class="space-y-6 animate-fade-in">
                    <h1 class="font-henny text-[#6C7559] login-brand">Revivo</h1>
                    
                    <div class="space-y-2">
                        <p class="text-gray-600 login-subtitle">Welcome back !!!</p>
                        <h2 class="font-semibold text-gray-800 login-title">Login</h2>
                    </div>
<form id="loginForm" class="space-y-4 sm:space-y-6 login-form-spacing">
    <div class="space-y-2">
        <label class="text-sm text-gray-600">Email</label>
        <input 
            type="email" 
            name="email" 
            id="email"
            class="w-full border-b-2 border-[#6C7559]/50 bg-transparent focus:outline-none focus:border-[#6C7559] transition-colors login-input"
            placeholder="Enter your email"
            required
        >
    </div>

    <div class="space-y-2">
        <label class="text-sm text-gray-600">Password</label>
        <div class="relative">
            <input 
                type="password" 
                name="password" 
                id="password"
                class="w-full border-b-2 border-[#6C7559]/50 bg-transparent focus:outline-none focus:border-[#6C7559] transition-colors pr-10 login-input"
                placeholder="Enter your password"
                required
            >
            <button 
                type="button" 
                class="absolute right-3 top-3 text-gray-400 hover:text-gray-600"
                onclick="togglePassword(this)"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
            </button>
        </div>
    </div>

    <button 
        type="submit" 
        class="w-full bg-[#6C7559] text-white rounded-md hover:bg-[#5a6349] transition-colors flex items-center justify-center gap-2 login-button"
    >
        LOGIN IN
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
    </button>
</form>

                                    </div>
            </div>

            <div class="illustration-bg p-4 sm:p-6 md:p-8 illustration-container">
                <div class="h-full flex flex-col items-center justify-center space-y-6">
                    <div class="text-[#6C7559] animate-bounce">
                        <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </div>
                    
                    <div class="flex space-x-4">
                        <div class="w-16 h-16 rounded-full bg-[#7C8B6F] bg-opacity-90 shadow-lg transform hover:scale-110 transition-transform duration-300"></div>
                        <div class="w-16 h-16 rounded-full bg-[#D4C8B0] bg-opacity-90 shadow-lg transform hover:scale-110 transition-transform duration-300"></div>
                        <div class="w-16 h-16 rounded-full bg-[#5F694D] bg-opacity-90 shadow-lg transform hover:scale-110 transition-transform duration-300"></div>
                    </div>

                    <div class="text-center">
                        <h3 class="text-2xl font-henny text-[#6C7559]">Admin Panel</h3>
                        <p class="text-gray-600 mt-2">Manage your store with ease</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function togglePassword(button) {
            const input = button.previousElementSibling;
            input.type = input.type === 'password' ? 'text' : 'password';
        }

    document.getElementById('loginForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        
        if (!email || !password) {
            Swal.fire({
                icon: 'error',
                title: 'Validation Error',
                text: 'Please fill in all fields',
                confirmButtonColor: '#6C7559'
            });
            return;
        }
        
        try {
            const response = await fetch('/admin/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ email, password })
            });
            
            const data = await response.json();
            
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Login Successful',
                    text: 'Redirecting to dashboard...',
                    confirmButtonColor: '#6C7559',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.href = '/admin/dashboard';
                });
            } else {
                throw new Error(data.message || 'Login failed');
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Login Failed',
                text: error.message || 'Invalid credentials',
                confirmButtonColor: '#6C7559'
            });
        }
    });

    function togglePassword(button) {
        const input = button.previousElementSibling;
        input.type = input.type === 'password' ? 'text' : 'password';
    }


    </script>
</body>
</html>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Henny+Penny&display=swap');
    .font-henny {
        font-family: 'Henny Penny', cursive;
    }
</style>
