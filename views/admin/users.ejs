<%- include('../partials/admin/admin-header.ejs') %>
<%- include('../partials/admin/admin-sidebar', {currentPage: 'users'}) %>

<div class="flex-1 overflow-auto p-2 md:p-4 lg:p-6 pt-16 md:pt-20">
    <div class="flex flex-col gap-3 md:gap-4 mb-4 md:mb-6">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 md:gap-4">
            <h1 class="text-lg md:text-xl lg:text-2xl font-semibold text-gray-800">Users</h1>
            <button onclick="window.location.href='/admin/add-user'" 
                    class="bg-[#6C7559] hover:bg-[#5a6349] text-white px-2 py-1.5 md:px-3 md:py-2 lg:px-4 lg:py-2 rounded-lg flex items-center space-x-1 md:space-x-2 transition-colors duration-200 text-xs md:text-sm lg:text-base">
                <svg class="w-3 h-3 md:w-4 md:h-4 lg:w-5 lg:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                <span>ADD USER +</span>
            </button>
        </div>

        <div class="relative w-full">
            <form id="searchForm" action="/admin/users" method="GET">
                <input type="text" 
                       name="search"
                       value="<%= searchQuery || '' %>"
                       placeholder="Search users..." 
                       class="w-full pl-8 pr-3 py-2 md:pl-10 md:pr-4 md:py-2.5 text-xs md:text-sm lg:text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#6C7559] focus:border-transparent shadow-sm"
                       onkeyup="debounceSearch(this.value)">
                <div class="absolute inset-y-0 left-2 md:left-3 flex items-center pointer-events-none">
                    <svg class="w-3 h-3 md:w-4 md:h-4 lg:w-5 lg:h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
            </form>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
        <!-- Mobile View (Cards) -->
        <div class="block md:hidden">
            <div class="divide-y divide-gray-200">
                <% for (let i = 0; i < data.length; i++) { %>
                    <div class="p-3 space-y-2">
                        <div class="flex items-center space-x-2">
                            <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center">
                                <% if (data[i].profileImage) { %>
                                    <img src="<%= data[i].profileImage %>" alt="Profile" class="w-full h-full rounded-full object-cover">
                                <% } else { %>
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                <% } %>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-sm font-medium truncate"><%= data[i].name %></h3>
                                <p class="text-xs text-gray-500 truncate"><%= data[i].email %></p>
                            </div>
                        </div>
                        <div class="text-xs text-gray-500 space-y-1">
                            <p class="truncate">Phone: <%= data[i].phone || 'N/A' %></p>
                            <p>Created: <%= new Date(data[i].createdAt).toLocaleDateString() %></p>
                        </div>
                        <div class="flex items-center justify-end space-x-2">
                            <% if (!data[i].isBlocked) { %>
                                <a href="/admin/blockUser?id=<%= data[i]._id %>"
                                   class="px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-600">
                                    BLOCK
                                </a>
                            <% } else { %>
                                <a href="/admin/unblockUser?id=<%= data[i]._id %>"
                                   class="px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-600">
                                    UNBLOCK
                                </a>
                            <% } %>
                            <a href="/admin/users/<%= data[i]._id %>/edit" class="text-blue-600 hover:text-blue-800">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                          d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                </svg>
                            </a>
                            <button onclick="deleteUser('<%= data[i]._id %>')" class="text-red-600 hover:text-red-800">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                            </button>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Desktop/Tablet View (Table) -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full whitespace-nowrap">
                <thead>
                    <tr class="bg-gray-50 text-left">
                        <th class="px-4 py-2 text-xs md:text-sm font-medium text-gray-500 uppercase tracking-wider">User</th>
                        <th class="px-4 py-2 text-xs md:text-sm font-medium text-gray-500 uppercase tracking-wider">Name</th>
                        <th class="px-4 py-2 text-xs md:text-sm font-medium text-gray-500 uppercase tracking-wider">Email</th>
                        <th class="px-4 py-2 text-xs md:text-sm font-medium text-gray-500 uppercase tracking-wider">Phone</th>
                        <th class="px-4 py-2 text-xs md:text-sm font-medium text-gray-500 uppercase tracking-wider">Created</th>
                        <th class="px-4 py-2 text-xs md:text-sm font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <% for (let i = 0; i < data.length; i++) { %>
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3">
                                <div class="w-8 h-8 md:w-10 md:h-10 rounded-full bg-gray-200 flex items-center justify-center">
                                    <% if (data[i].profileImage) { %>
                                        <img src="<%= data[i].profileImage %>" alt="Profile" class="w-full h-full rounded-full object-cover">
                                    <% } else { %>
                                        <svg class="w-4 h-4 md:w-5 md:h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                        </svg>
                                    <% } %>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-xs md:text-sm text-gray-900 max-w-[120px] md:max-w-none truncate"><%= data[i].name %></td>
                            <td class="px-4 py-3 text-xs md:text-sm text-gray-500 max-w-[150px] md:max-w-none truncate"><%= data[i].email %></td>
                            <td class="px-4 py-3 text-xs md:text-sm text-gray-500"><%= data[i].phone || 'N/A' %></td>
                            <td class="px-4 py-3 text-xs md:text-sm text-gray-500 whitespace-nowrap"><%= new Date(data[i].createdAt).toLocaleDateString() %></td>
                            <td class="px-4 py-3 text-xs md:text-sm flex space-x-1 md:space-x-2">
                                <% if (!data[i].isBlocked) { %>
                                    <a href="/admin/blockUser?id=<%= data[i]._id %>"
                                       class="px-2 py-1 md:px-3 md:py-1 rounded-full text-xs font-medium bg-red-100 text-red-600 whitespace-nowrap">
                                        BLOCK
                                    </a>
                                <% } else { %>
                                    <a href="/admin/unblockUser?id=<%= data[i]._id %>"
                                       class="px-2 py-1 md:px-3 md:py-1 rounded-full text-xs font-medium bg-green-100 text-green-600 whitespace-nowrap">
                                        UNBLOCK
                                    </a>
                                <% } %>
                                <a href="/admin/users/<%= data[i]._id %>/edit" class="text-blue-600 hover:text-blue-800 flex items-center">
                                    <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                                <button onclick="deleteUser('<%= data[i]._id %>')" class="text-red-600 hover:text-red-800 flex items-center">
                                    <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                              d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="px-3 md:px-4 py-2 md:py-3 bg-white border-t border-gray-200">
            <div class="flex flex-col sm:flex-row justify-between items-center gap-2">
                <p class="text-xs md:text-sm text-gray-700 order-2 sm:order-1">
                    Showing <%= (currentPage - 1) * perPage + 1 %> to <%= Math.min(currentPage * perPage, totalUsers) %> of <%= totalUsers %> users
                </p>
                <% if (totalPages > 1) { %>
                    <nav aria-label="Page navigation" class="order-1 sm:order-2">
                        <ul class="pagination flex space-x-1 md:space-x-2">
                            <% if (currentPage > 1) { %>
                                <li class="page-item">
                                    <a class="px-2 py-1 text-xs md:text-sm rounded border border-gray-300 text-gray-700 hover:bg-gray-100" 
                                       href="?page=<%= currentPage - 1 %><% if (searchQuery) { %>&search=<%= searchQuery %><% } %>">
                                        Previous
                                    </a>
                                </li>
                            <% } %>
                            
                            <% for(let i = 1; i <= totalPages; i++) { %>
                                <li class="page-item">
                                    <a class="px-2 py-1 text-xs md:text-sm rounded border <%= (i === currentPage) ? 'bg-[#6C7559] text-white' : 'border-gray-300 text-gray-700 hover:bg-gray-100' %>" 
                                       href="?page=<%= i %><% if (searchQuery) { %>&search=<%= searchQuery %><% } %>">
                                        <%= i %>
                                    </a>
                                </li>
                            <% } %>
                            
                            <% if (currentPage < totalPages) { %>
                                <li class="page-item">
                                    <a class="px-2 py-1 text-xs md:text-sm rounded border border-gray-300 text-gray-700 hover:bg-gray-100" 
                                       href="?page=<%= currentPage + 1 %><% if (searchQuery) { %>&search=<%= searchQuery %><% } %>">
                                        Next
                                    </a>
                                </li>
                            <% } %>
                        </ul>
                    </nav>
                <% } %>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-lg p-4 md:p-6 max-w-xs w-full mx-2 sm:max-w-sm">
        <h3 class="text-base md:text-lg lg:text-xl font-semibold text-gray-900 mb-3 md:mb-4">Confirm Delete</h3>
        <p class="text-xs md:text-sm lg:text-base text-gray-600 mb-4 md:mb-6">Are you sure you want to delete this user? This action cannot be undone.</p>
        <div class="flex justify-end space-x-2 md:space-x-4">
            <button onclick="closeDeleteModal()" 
                    class="px-2 py-1 md:px-3 md:py-2 text-xs md:text-sm lg:text-base text-gray-600 hover:text-gray-800 font-medium">
                Cancel
            </button>
            <button id="confirmDelete" 
                    class="px-2 py-1 md:px-3 md:py-2 text-xs md:text-sm lg:text-base bg-red-500 hover:bg-red-600 text-white rounded-lg">
                Delete
            </button>
        </div>
    </div>
</div>

<script>
    let userIdToDelete = null;

    function deleteUser(userId) {
        userIdToDelete = userId;
        document.getElementById('deleteModal').classList.remove('hidden');
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        userIdToDelete = null;
    }

    document.getElementById('confirmDelete').addEventListener('click', function() {
        if (userIdToDelete) {
            fetch(`/admin/users/${userIdToDelete}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => {
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Error deleting user');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting user');
            });
        }
        closeDeleteModal();
    });

    document.getElementById('deleteModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeDeleteModal();
        }
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeDeleteModal();
        }
    });

    let debounceTimer;
    function debounceSearch(query) {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            document.getElementById('searchForm').submit();
        }, 500); 
    }
</script>

<%- include('../partials/admin/admin-footer') %>
