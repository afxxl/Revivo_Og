<meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, private">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg">
<link rel="apple-touch-icon" href="/favicon/favicon.svg">
<link rel="manifest" href="/favicon/site.webmanifest">
<meta name="theme-color" content="#2C2C2C">


<div class="w-full bg-[#2C2C2C] text-white text-xs py-1">
    <div class="flex justify-center items-center">
        <p class="text-center tracking-wider">FREE SHIPPING WORLD WIDE ON ALL PRE-PAID ORDERS</p>
    </div>
</div>

<div id="mainHeader" class="w-full bg-transparent border-b border-[#2C2C2C] border-opacity-10 sticky top-0 z-50 transition-colors duration-300 backdrop-blur-sm">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 nav-container">
        <!-- Desktop Header -->
        <div class="hidden md:flex justify-between items-center py-4">
            <div class="flex items-center w-1/3">
                <div class="flex gap-4 lg:gap-8 justify-between">
                    <a href="/shop" class="nav-link">SHOP ALL</a>
                    <a href="/featured" class="nav-link">FEATURED</a>
                    <a href="/new-arrivals" class="nav-link">NEW ARRIVALS</a>
                </div>
            </div>

            <div class="flex justify-center w-1/3">
                <a href="/" class="brand-name font-henny">REVIVO</a>
            </div>

            <div class="flex items-center justify-end w-1/3 gap-3 lg:gap-6">
                <div id="auth-state">
                    <% if(locals.user){ %>
                        <div class="dropdown"> 
                            <button class="nav-link flex items-center gap-1">
                                <%= locals.user.name %>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </button>
                            <div class="dropdown-content">
                                <div class="dropdown-header">
                                    <div class="user-name"><%= locals.user.name %></div>
                                    <div class="user-email"><%= locals.user.email %></div>
                                </div>
                                <a href="/profile">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                    Profile
                                </a>
                                <a href="/profile#orders">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                                    </svg>
                                    Orders
                                </a>
                                <a href="/wishlist">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                                    </svg>
                                    Wishlist
                                </a>
                                <a href="/wallet">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2z"/>
                                    </svg>
                                    Wallet
                                </a>
                                <a href="#" id="referralMenuLink" class="relative">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"/>
                                    </svg>
                                    Referrals
                                    <span class="absolute top-0 right-0 h-2 w-2 rounded-full bg-green-500 animate-pulse"></span>
                                </a>
                                <a href="/logout" class="logout-link">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                    </svg>
                                    Logout
                                </a>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login" class="nav-link">LOGIN</a>
                    <% } %>
                </div>
                
                <div class="flex items-center gap-3">
                    <a href="/wishlist" class="nav-link relative">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                        <span id="wishlist-count" class="absolute -top-2 -right-2 bg-[#f8c78d] text-[#2C2C2C] text-xs rounded-full w-5 h-5 flex items-center justify-center">
                            <%= locals.wishlistCount || 0 %>
                        </span>
                    </a>

                    <a href="/cart" class="nav-link relative">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                        </svg>
                        <span id="cart-count" class="absolute -top-2 -right-2 bg-[#f8c78d] text-[#2C2C2C] text-xs rounded-full w-5 h-5 flex items-center justify-center">
                            <%= locals.cartCount || 0 %>
                        </span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Mobile Header -->
        <div class="md:hidden py-3">
            <div class="grid grid-cols-3 items-center w-full">
                <div class="flex justify-start">
                    <button id="burger-menu" class="p-2 text-[#2C2C2C] transition-colors focus:outline-none" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle navigation menu">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
                
                <div class="flex justify-center">
                    <a href="/" class="brand-name font-henny text-xl sm:text-2xl">REVIVO</a>
                </div>
                
                <div class="flex justify-end">
                    <a href="/wishlist" class="p-2 nav-link relative mr-1">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                        </svg>
                        <span class="absolute -top-1 -right-1 bg-[#f8c78d] text-[#2C2C2C] text-xs rounded-full w-4 h-4 flex items-center justify-center text-[10px] mobile-wishlist-count">
                            <%= locals.wishlistCount || 0 %>
                        </span>
                    </a>
                
                    <a href="/cart" class="p-2 nav-link relative">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                        </svg>
                        <span class="absolute -top-1 -right-1 bg-[#f8c78d] text-[#2C2C2C] text-xs rounded-full w-4 h-4 flex items-center justify-center text-[10px] mobile-cart-count">
                            <%= locals.cartCount || 0 %>
                        </span>
                    </a>
                </div>
            </div>

            <div id="mobile-menu" class="mobile-menu-container overflow-hidden" aria-hidden="true">
                <div class="pt-3 space-y-1 px-2">
                    <div class="flex flex-col">
                        <a href="/shop" class="mobile-nav-link nav-link block text-center py-3">SHOP ALL</a>
                        <a href="/featured" class="mobile-nav-link nav-link block text-center py-3">FEATURED</a>
                        <a href="/new-arrivals" class="mobile-nav-link nav-link block text-center py-3">NEW ARRIVALS</a>
                        
                        <% if(locals.user){ %>
                            <a href="/profile" class="mobile-nav-link nav-link block text-center py-3">MY PROFILE</a>
                            <a href="/profile#orders" class="mobile-nav-link nav-link block text-center py-3">MY ORDERS</a>
                            <a href="/wishlist" class="mobile-nav-link nav-link block text-center py-3">WISHLIST</a>
                            <a href="/cart" class="mobile-nav-link nav-link block text-center py-3">CART</a>
                            <a href="/wallet" class="mobile-nav-link nav-link block text-center py-3">WALLET</a>
                            <a href="#" id="mobilReferralMenuLink" class="mobile-nav-link nav-link block text-center py-3 relative">REFERRALS <span class="inline-block h-2 w-2 rounded-full bg-green-500 animate-pulse ml-1"></span></a>
                            <a href="/logout" class="mobile-nav-link nav-link block text-center py-3 text-red-600">LOGOUT</a>
                        <% } else { %>
                            <a href="/login" class="mobile-nav-link nav-link block text-center py-3">LOGIN</a>
                            <a href="/signup" class="mobile-nav-link nav-link block text-center py-3">SIGN UP</a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



